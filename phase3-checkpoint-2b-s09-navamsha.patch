+/**
+ * Block 15 — NAVAMSHA (Level 2). Complete once gate S-09 closed (Option C Pushkara table).
+ *
+ *   sign          D-9 sign (Traditional Parasara element seeds; navamshaCore.d9Placement)
+ *   dignity       natural-friendship dignity of the body in its D-9 sign (S-01/S-01b); nodes "—"
+ *   is_vargottama Rashi sign == Navamsha sign (sign-name equality only, spec Rule 18)
+ *   is_pushkara   Rashi degree inside the sign's Pushkara Navamsha zones (pushkara.ts, S-09 Option C)
+ *   _available    true: the D-9 is derived natively from the chart, never missing
+ *
+ * Pure projection of CanonicalChart; no ephemeris access. Fails closed on an invalid sign or sign degree.
+ */
+
+import type { NavamshaBlock, NineBody } from "../../types/dssme-canonical-types.ts";
+import { ZODIAC_SIGNS_ARIES_FIRST } from "../../types/dssme-canonical-types.ts";
+import { NINE_BODIES_ORDER } from "../astronomy/planetaryPositions.ts";
+import type { BlockContext, BlockIssue, BlockResult } from "./blockTypes.ts";
+import { errorIssue, finalizeBlock, mapNineBodies } from "./blockResult.ts";
+import { navamshaPlacements } from "./navamshaCore.ts";
+import { isPushkaraNavamsha } from "./pushkara.ts";
+
+function validateInputs(ctx: BlockContext): BlockIssue[] {
+  const issues: BlockIssue[] = [];
+  for (const body of NINE_BODIES_ORDER) {
+    const p = ctx.chart.planets[body];
+    if (!p) {
+      issues.push(errorIssue(`planets.${body}`, `${body} is missing`));
+      continue;
+    }
+    if (!ZODIAC_SIGNS_ARIES_FIRST.includes(p.sign)) {
+      issues.push(errorIssue(`planets.${body}.sign`, `invalid sign "${String(p.sign)}"`));
+    }
+    if (!Number.isFinite(p.signDegree) || p.signDegree < 0 || p.signDegree >= 30) {
+      issues.push(errorIssue(`planets.${body}.signDegree`, `sign degree must be in [0, 30), found ${String(p.signDegree)}`));
+    }
+  }
+  return issues;
+}
+
+export function buildNavamshaBlock(ctx: BlockContext): BlockResult<NavamshaBlock> {
+  const issues = validateInputs(ctx);
+  const hasError = issues.some((i) => i.severity === "error");
+  let value: NavamshaBlock | null = null;
+  if (!hasError) {
+    const d9 = navamshaPlacements(ctx.chart);
+    value = {
+      _available: true,
+      ...mapNineBodies((body: NineBody) => {
+        const placement = d9[body];
+        const rashi = ctx.chart.planets[body];
+        return {
+          sign: placement.sign,
+          dignity: placement.dignity,
+          is_vargottama: placement.isVargottama,
+          is_pushkara: isPushkaraNavamsha(rashi.sign, rashi.signDegree),
+        };
+      }),
+    };
+  }
+  return finalizeBlock({ blockId: "NAVAMSHA", ctx, inputs: ["CanonicalChart"], value, issues });
+}
