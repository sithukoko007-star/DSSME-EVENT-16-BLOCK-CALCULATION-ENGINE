+/**
+ * Pushkara Navamsha (Gate S-09, CLOSED — owner decision "Option C", corrected 24-zone table).
+ *
+ * Each Rashi has exactly TWO Pushkara Navamsha zones, each one navamsha (3°20′) wide, fixed by the sign's element:
+ *   fire  (Aries, Leo, Sagittarius)   7th and 9th navamsa  -> 20°00′–23°20′  and 26°40′–30°00′
+ *   earth (Taurus, Virgo, Capricorn)  3rd and 5th navamsa  ->  6°40′–10°00′  and 13°20′–16°40′
+ *   air   (Gemini, Libra, Aquarius)   6th and 8th navamsa  -> 16°40′–20°00′  and 23°20′–26°40′
+ *   water (Cancer, Scorpio, Pisces)   1st and 3rd navamsa  ->  0°00′–3°20′   and  6°40′–10°00′
+ *
+ * `is_pushkara` is true iff the body's RASHI (D-1) intra-sign longitude lies in one of its sign's zones.
+ * Intervals are half-open [start, end): the start degree is included, the end degree is not.
+ * Rahu and Ketu are evaluated like every other body, from their own Rashi sign and degree (spec Rule 15).
+ *
+ * Evidence (source-level, PyJHora NOT executed): PyJHora const.pushkara_navamsa / charts.planets_in_pushkara_navamsa_bhaga
+ * (same ranges, half-open) and an independent secondary reference (aaps.space) that lists the same 24 zones.
+ * Neither is a critical edition of a Sanskrit text. The DSSME Master Contract's original table is NOT edited by this
+ * module; it is preserved as a historical source record in the decision log and recorded as a specification
+ * correction / Compatibility Exception (reports/PHASE_3_DECISION_LOG.md, S-09).
+ *
+ * Arithmetic is done in arcminutes with a 1e-9 arcminute (~1.7e-11°) guard so that IEEE-754 noise at an exact boundary
+ * (e.g. 19.999999999999996° for a true 20°) classifies as the start of the zone, never as the tail of the previous one.
+ * Same technique and rationale as the frozen Phase 2 pada guard (EPS_PADA).
+ */
+
+import type { ZodiacSign } from "../../types/dssme-canonical-types.ts";
+
+export type SignElement = "fire" | "earth" | "air" | "water";
+
+export const SIGN_ELEMENT: Readonly<Record<ZodiacSign, SignElement>> = {
+  Aries: "fire", Leo: "fire", Sagittarius: "fire",
+  Taurus: "earth", Virgo: "earth", Capricorn: "earth",
+  Gemini: "air", Libra: "air", Aquarius: "air",
+  Cancer: "water", Scorpio: "water", Pisces: "water",
+};
+
+/** One Pushkara zone, in arcminutes within the sign: [startArcmin, endArcmin). */
+export interface PushkaraZone {
+  readonly startArcmin: number;
+  readonly endArcmin: number;
+}
+
+const NAVAMSA_ARCMIN = 200; // 3°20′
+
+/** Pushkara navamsa ordinals (1..9) per element. Zones are derived from these, not typed twice. */
+const PUSHKARA_NAVAMSA_ORDINALS: Readonly<Record<SignElement, readonly [number, number]>> = {
+  fire: [7, 9],
+  earth: [3, 5],
+  air: [6, 8],
+  water: [1, 3],
+};
+
+function zoneOf(ordinal: number): PushkaraZone {
+  return { startArcmin: (ordinal - 1) * NAVAMSA_ARCMIN, endArcmin: ordinal * NAVAMSA_ARCMIN };
+}
+
+export function pushkaraZones(sign: ZodiacSign): readonly [PushkaraZone, PushkaraZone] {
+  const element = SIGN_ELEMENT[sign];
+  if (element === undefined) throw new Error(`BLOCK_ERROR: unknown zodiac sign "${String(sign)}"`);
+  const [a, b] = PUSHKARA_NAVAMSA_ORDINALS[element];
+  return [zoneOf(a), zoneOf(b)];
+}
+
+const ARCMIN_GUARD = 1e-9;
+
+/** True iff `signDegree` (0 <= d < 30, degrees within the Rashi sign) lies in a Pushkara Navamsha zone of `sign`. */
+export function isPushkaraNavamsha(sign: ZodiacSign, signDegree: number): boolean {
+  if (!Number.isFinite(signDegree) || signDegree < 0 || signDegree >= 30) {
+    throw new Error(`BLOCK_ERROR: sign degree must be in [0, 30), found ${String(signDegree)}`);
+  }
+  const arcmin = signDegree * 60 + ARCMIN_GUARD;
+  return pushkaraZones(sign).some((z) => arcmin >= z.startArcmin && arcmin < z.endArcmin);
+}
