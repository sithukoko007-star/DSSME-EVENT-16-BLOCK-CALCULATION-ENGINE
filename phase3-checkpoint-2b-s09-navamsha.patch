+/**
+ * Phase 3 — NAVAMSHA block tests (hand-built chart, no ephemeris).
+ * Expected values are derived BY HAND from the D-9 rule, the natural-friendship dignity rule (S-01/S-01b)
+ * and the S-09 Option C Pushkara table. Hand derivations are in the comments.
+ */
+
+import assert from "node:assert/strict";
+import { buildNavamshaBlock, createBlockContext } from "../../src/engine/blocks/index.ts";
+import type { NavamshaBlock } from "../../src/types/dssme-canonical-types.ts";
+import { HAND_JD_UT, makeHandChart } from "./fixtures/handChart.ts";
+
+const EXPECTED: NavamshaBlock = {
+  _available: true,
+  // Leo 28°: navamsa 9 (idx 8), fire seed Aries -> Sagittarius; Sun in Jupiter's sign = Friend; Leo 26°40′–30° is Pushkara.
+  Sun: { sign: "Sagittarius", dignity: "Friend", is_vargottama: false, is_pushkara: true },
+  // Scorpio 2°: navamsa 1, water seed Cancer -> Cancer; Moon own sign; Scorpio 0°–3°20′ is Pushkara.
+  Moon: { sign: "Cancer", dignity: "Own", is_vargottama: false, is_pushkara: true },
+  // Gemini 28°: navamsa 9, air seed Libra+8 -> Gemini (Vargottama); Mars -> Mercury natural Enemy; Gemini 28° is not in 16°40′–20° / 23°20′–26°40′.
+  Mars: { sign: "Gemini", dignity: "Enemy", is_vargottama: true, is_pushkara: false },
+  // Virgo 14°: navamsa 5, earth seed Capricorn+4 -> Taurus; Mercury -> Venus natural Friend; Virgo 13°20′–16°40′ is Pushkara.
+  Mercury: { sign: "Taurus", dignity: "Friend", is_vargottama: false, is_pushkara: true },
+  // Cancer 22°: navamsa 7, water seed Cancer+6 -> Capricorn; Jupiter debilitated; Cancer 22° is outside 0°–3°20′ / 6°40′–10°.
+  Jupiter: { sign: "Capricorn", dignity: "Debilitated", is_vargottama: false, is_pushkara: false },
+  // Libra 9°: navamsa 3, air seed Libra+2 -> Sagittarius; Venus -> Jupiter natural Neutral; Libra 9° is outside 16°40′–20° / 23°20′–26°40′.
+  Venus: { sign: "Sagittarius", dignity: "Neutral", is_vargottama: false, is_pushkara: false },
+  // Pisces 17°: navamsa 6, water seed Cancer+5 -> Sagittarius; Saturn -> Jupiter natural Neutral; Pisces 17° is outside 0°–3°20′ / 6°40′–10°.
+  Saturn: { sign: "Sagittarius", dignity: "Neutral", is_vargottama: false, is_pushkara: false },
+  // Aquarius 4°: navamsa 2, air seed Libra+1 -> Scorpio; nodes carry "—"; Aquarius 4° is outside both zones.
+  Rahu: { sign: "Scorpio", dignity: "—", is_vargottama: false, is_pushkara: false },
+  // Leo 4°: navamsa 2, fire seed Aries+1 -> Taurus; Leo 4° is outside 20°–23°20′ / 26°40′–30°.
+  Ketu: { sign: "Taurus", dignity: "—", is_vargottama: false, is_pushkara: false },
+};
+
 export function runNavamshaBlockTests(): void {
+  console.log("Running Phase 3 NAVAMSHA Block Tests...");
+
+  const ctx = createBlockContext(makeHandChart());
+  const result = buildNavamshaBlock(ctx);
+  assert.equal(result.blockId, "NAVAMSHA");
+  assert.equal(result.status, "OK");
+  assert.deepEqual(result.issues, []);
+  assert.equal(result.instantJdUt, HAND_JD_UT);
+  assert.deepEqual(result.provenance, { chart: { ephemeris: "swisseph-wasm", isDegraded: false }, inputs: ["CanonicalChart"], auxSources: [] });
+  assert.deepEqual(result.value, EXPECTED);
+  assert.deepEqual(Object.keys(result.value ?? {}), ["_available", "Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn", "Rahu", "Ketu"]);
+  assert.equal(JSON.stringify(buildNavamshaBlock(ctx)), JSON.stringify(result), "deterministic");
+
+  // Degraded chart provenance is carried, not rejected (state block).
+  const degraded = buildNavamshaBlock(createBlockContext(makeHandChart("mixed")));
+  assert.equal(degraded.status, "OK");
+  assert.deepEqual(degraded.provenance.chart, { ephemeris: "mixed", isDegraded: true });
+
+  // Nodes ARE evaluated for Pushkara from their own Rashi position (spec Rule 15), and keep dignity "—".
+  const nodes = makeHandChart();
+  nodes.planets.Rahu.sign = "Aquarius";
+  nodes.planets.Rahu.signDegree = 17; // air, 6th navamsa -> Pushkara
+  nodes.planets.Ketu.sign = "Leo";
+  nodes.planets.Ketu.signDegree = 27; // fire, 9th navamsa -> Pushkara
+  const nr = buildNavamshaBlock(createBlockContext(nodes)).value;
+  assert.equal(nr?.Rahu.is_pushkara, true);
+  assert.equal(nr?.Ketu.is_pushkara, true);
+  assert.equal(nr?.Rahu.dignity, "—");
+  assert.equal(nr?.Ketu.dignity, "—");
+
+  // Boundary through the block: Aries 20°00′ is Pushkara, 23°20′ is not (Sun moved into Aries for this probe).
+  const probe = (deg: number): boolean | undefined => {
+    const c = makeHandChart();
+    c.planets.Sun.sign = "Aries";
+    c.planets.Sun.signDegree = deg;
+    return buildNavamshaBlock(createBlockContext(c)).value?.Sun.is_pushkara;
+  };
+  assert.equal(probe(20), true);
+  assert.equal(probe(23 + 20 / 60), false);
+  assert.equal(probe(26 + 40 / 60), true);
+
+  // Fail-closed on invalid inputs.
+  const expectFailed = (mutate: (c: ReturnType<typeof makeHandChart>) => void, field: string): void => {
+    const c = makeHandChart();
+    mutate(c);
+    const r = buildNavamshaBlock(createBlockContext(c));
+    assert.equal(r.status, "FAILED_CLOSED");
+    assert.equal(r.value, null);
+    assert.ok(r.issues.some((i) => i.severity === "error" && i.field === field), `${field}: ${JSON.stringify(r.issues)}`);
+  };
+  expectFailed((c) => { c.planets.Moon.signDegree = 30; }, "planets.Moon.signDegree");
+  expectFailed((c) => { c.planets.Mars.signDegree = -0.5; }, "planets.Mars.signDegree");
+  expectFailed((c) => { c.planets.Venus.signDegree = Number.NaN; }, "planets.Venus.signDegree");
+  expectFailed((c) => { Reflect.set(c.planets.Saturn, "sign", "Nonsense"); }, "planets.Saturn.sign");
+
+  console.log("✓ Phase 3 NAVAMSHA Block Tests Passed!");
+}
