+/**
+ * Phase 3 — Pushkara Navamsha tests (gate S-09, Option C: corrected 24-zone, element-based table).
+ *
+ * The approved table below is typed out BY HAND from the owner's decision (independent of the implementation's
+ * navamsa-ordinal derivation). PyJHora comparison is source-level only; PyJHora was NOT executed.
+ */
+
+import assert from "node:assert/strict";
+import { isPushkaraNavamsha, pushkaraZones, SIGN_ELEMENT } from "../../src/engine/blocks/index.ts";
+import { ZODIAC_SIGNS_ARIES_FIRST, type ZodiacSign } from "../../src/types/dssme-canonical-types.ts";
+
+const dms = (d: number, m = 0, s = 0): number => d + m / 60 + s / 3600;
+type Zone = readonly [number, number]; // [start, end) in degrees
+
+/** Owner-approved Option C table (S-09). */
+const APPROVED: Readonly<Record<ZodiacSign, readonly [Zone, Zone]>> = {
+  Aries: [[dms(20), dms(23, 20)], [dms(26, 40), dms(30)]],
+  Taurus: [[dms(6, 40), dms(10)], [dms(13, 20), dms(16, 40)]],
+  Gemini: [[dms(16, 40), dms(20)], [dms(23, 20), dms(26, 40)]],
+  Cancer: [[dms(0), dms(3, 20)], [dms(6, 40), dms(10)]],
+  Leo: [[dms(20), dms(23, 20)], [dms(26, 40), dms(30)]],
+  Virgo: [[dms(6, 40), dms(10)], [dms(13, 20), dms(16, 40)]],
+  Libra: [[dms(16, 40), dms(20)], [dms(23, 20), dms(26, 40)]],
+  Scorpio: [[dms(0), dms(3, 20)], [dms(6, 40), dms(10)]],
+  Sagittarius: [[dms(20), dms(23, 20)], [dms(26, 40), dms(30)]],
+  Capricorn: [[dms(6, 40), dms(10)], [dms(13, 20), dms(16, 40)]],
+  Aquarius: [[dms(16, 40), dms(20)], [dms(23, 20), dms(26, 40)]],
+  Pisces: [[dms(0), dms(3, 20)], [dms(6, 40), dms(10)]],
+};
+
+/** The DSSME Master Contract's ORIGINAL table (extraction prompt §6 / contract §3.2), kept as a historical record. */
+const HISTORICAL_SPEC: Readonly<Record<ZodiacSign, readonly Zone[]>> = {
+  Aries: [[dms(16), dms(20)]],
+  Taurus: [[dms(13, 20), dms(16, 40)]],
+  Gemini: [[dms(23, 20), dms(26, 40)]],
+  Cancer: [[dms(26, 40), dms(30)]],
+  Leo: [[dms(0), dms(3, 20)], [dms(26, 40), dms(30)]],
+  Virgo: [[dms(23, 20), dms(26, 40)]],
+  Libra: [[dms(10), dms(13, 20)]],
+  Scorpio: [[dms(0), dms(3, 20)]],
+  Sagittarius: [[dms(16, 40), dms(20)]],
+  Capricorn: [[dms(13, 20), dms(16, 40)], [dms(23, 20), dms(26, 40)]],
+  Aquarius: [[dms(6, 40), dms(10)]],
+  Pisces: [[dms(10), dms(13, 20)]],
+};
+
+const close = (a: number, b: number): boolean => Math.abs(a - b) < 1e-9;
+
+export function runPushkaraNavamshaTests(): void {
+  console.log("Running Phase 3 Pushkara Navamsha Tests (S-09, Option C)...");
+
+  // 1. Implemented zones == the approved table, for every sign (degrees, via arcminutes).
+  for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+    const zones = pushkaraZones(sign);
+    const want = APPROVED[sign];
+    assert.equal(zones.length, 2, `${sign}: exactly two zones`);
+    zones.forEach((z, i) => {
+      const w = want[i];
+      assert.ok(w !== undefined);
+      assert.ok(close(z.startArcmin / 60, w[0]) && close(z.endArcmin / 60, w[1]), `${sign} zone ${i + 1}`);
+      assert.equal(z.endArcmin - z.startArcmin, 200, `${sign}: each zone is one navamsha (3°20′)`);
+    });
+  }
+
+  // 2. Element pattern (independent statement of the rule): fire 7th/9th, earth 3rd/5th, air 6th/8th, water 1st/3rd navamsa.
+  const ordinals = { fire: [7, 9], earth: [3, 5], air: [6, 8], water: [1, 3] } as const;
+  for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+    const [a, b] = ordinals[SIGN_ELEMENT[sign]];
+    const zones = pushkaraZones(sign);
+    assert.deepEqual(zones.map((z) => z.startArcmin / 200 + 1), [a, b], `${sign} navamsa ordinals`);
+  }
+  assert.deepEqual(
+    ZODIAC_SIGNS_ARIES_FIRST.map((s) => SIGN_ELEMENT[s]),
+    ["fire", "earth", "air", "water", "fire", "earth", "air", "water", "fire", "earth", "air", "water"],
+    "element cycles fire/earth/air/water",
+  );
+
+  // 3. EVERY zone start and end, half-open, plus the noise guard. 12 signs x 2 zones.
+  const EPS = 1e-9; // degrees: much larger than the 1.7e-11° guard, much smaller than any real gap
+  for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+    for (const [start, end] of APPROVED[sign]) {
+      assert.equal(isPushkaraNavamsha(sign, start), true, `${sign} start ${start} is included`);
+      // A zone starting at 0° has no in-sign degree before it (a negative degree is invalid input, tested in section 6).
+      if (start > 0) assert.equal(isPushkaraNavamsha(sign, start - EPS), false, `${sign} just before start is outside`);
+      assert.equal(isPushkaraNavamsha(sign, start + EPS), true, `${sign} just after start is inside`);
+      if (end < 30) {
+        assert.equal(isPushkaraNavamsha(sign, end - EPS), true, `${sign} just before end is inside`);
+        assert.equal(isPushkaraNavamsha(sign, end), false, `${sign} end ${end} is excluded`);
+        assert.equal(isPushkaraNavamsha(sign, end + EPS), false, `${sign} just after end is outside`);
+      } else {
+        assert.equal(isPushkaraNavamsha(sign, 29.999999999), true, `${sign} last degree before 30° is inside`);
+        assert.throws(() => isPushkaraNavamsha(sign, 30), /BLOCK_ERROR/, "30° is not a valid in-sign degree");
+      }
+      // IEEE-754 noise at an exact boundary (a true 20° computed as 19.999999999999996) must still be the zone start.
+      if (start > 0) assert.equal(isPushkaraNavamsha(sign, start - 1e-13), true, `${sign} float-noise guard at ${start}`);
+    }
+  }
+
+  // 4. Named representative cases (not the only validation — see 3 and 5).
+  assert.equal(isPushkaraNavamsha("Aries", dms(20)), true, "Aries 20°00′ is Pushkara");
+  assert.equal(isPushkaraNavamsha("Aries", dms(19, 59, 59)), false, "Aries 19°59′59″ is not");
+  assert.equal(isPushkaraNavamsha("Aries", dms(23, 20)), false, "Aries 23°20′ is not in the first zone");
+  assert.equal(isPushkaraNavamsha("Aries", dms(26, 40)), true, "Aries 26°40′ opens the second zone");
+  assert.equal(isPushkaraNavamsha("Taurus", dms(14, 47)), true, "earth: 5th navamsa");
+  assert.equal(isPushkaraNavamsha("Gemini", dms(18)), true, "air: 6th navamsa");
+  assert.equal(isPushkaraNavamsha("Cancer", dms(1)), true, "water: 1st navamsa");
+  assert.equal(isPushkaraNavamsha("Virgo", dms(14, 47)), true, "Virgo 14°47′ (the reference-chart Mercury) is inside 13°20′–16°40′");
+  assert.equal(isPushkaraNavamsha("Leo", dms(28, 57)), true, "Leo 28°57′ (reference-chart Sun)");
+  assert.equal(isPushkaraNavamsha("Scorpio", dms(2, 16)), true, "Scorpio 2°16′ (reference-chart Moon)");
+
+  // 5. Exhaustive 1-arcminute sweep: each sign has exactly 400 arcminutes (2 x 3°20′) of Pushkara, and the true
+  //    arcminutes coincide with exactly the Pushkara navamsa cells (navamsa index = floor(deg*9/30)), cross-checking D-9 arithmetic.
+  for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+    const ord = ordinals[SIGN_ELEMENT[sign]];
+    let count = 0;
+    for (let m = 0; m < 1800; m++) {
+      const deg = (m + 0.5) / 60; // arcminute midpoints: never on a boundary
+      const inZone = isPushkaraNavamsha(sign, deg);
+      if (inZone) count++;
+      const navamsa = Math.floor((deg * 9) / 30) + 1;
+      assert.equal(inZone, navamsa === ord[0] || navamsa === ord[1], `${sign} ${deg}°`);
+    }
+    assert.equal(count, 400, `${sign}: 400 Pushkara arcminutes`);
+  }
+
+  // 6. Invalid input fails loudly, never silently false.
+  assert.throws(() => isPushkaraNavamsha("Aries", -0.1), /BLOCK_ERROR/);
+  assert.throws(() => isPushkaraNavamsha("Aries", 30.5), /BLOCK_ERROR/);
+  assert.throws(() => isPushkaraNavamsha("Aries", Number.NaN), /BLOCK_ERROR/);
+  assert.throws(() => isPushkaraNavamsha("Nonsense" as ZodiacSign, 10), /BLOCK_ERROR/);
+
+  // 7. Specification correction / Compatibility Exception: the historical DSSME table is NOT the implemented one.
+  let identical = 0;
+  const sharing: ZodiacSign[] = [];
+  let offGrid = 0;
+  for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+    const spec = HISTORICAL_SPEC[sign];
+    const impl = APPROVED[sign];
+    const same = spec.length === impl.length && spec.every((z) => impl.some((w) => close(z[0], w[0]) && close(z[1], w[1])));
+    if (same) identical++;
+    if (spec.some((z) => impl.some((w) => close(z[0], w[0]) && close(z[1], w[1])))) sharing.push(sign);
+    for (const [start, end] of spec) {
+      if (!close((start * 60) % 200, 0) || !close((end - start) * 60, 200)) offGrid++;
+    }
+  }
+  assert.equal(identical, 0, "no sign has the same zone set in the historical spec and the corrected table");
+  assert.deepEqual(sharing, ["Taurus", "Gemini", "Leo", "Scorpio", "Capricorn"], "only five signs share at least one zone");
+  assert.equal(offGrid, 1, "exactly one historical zone (Aries 16°00′–20°00′, 4° wide) is off the navamsha grid");
+  assert.equal(HISTORICAL_SPEC.Aries.length, 1);
+  // Behavioural consequence, documented: the historical table flagged Aries 18° and missed Aries 21°; the corrected table is the reverse.
+  assert.equal(isPushkaraNavamsha("Aries", 18), false);
+  assert.equal(isPushkaraNavamsha("Aries", 21), true);
+
+  console.log("✓ Phase 3 Pushkara Navamsha Tests Passed!");
+}
