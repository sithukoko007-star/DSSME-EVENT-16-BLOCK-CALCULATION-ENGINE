const KALI_YUGA_EPOCH_JD_NOON = 588465;

/**
 * ဝေဒနေ့အရှင် (Vara Lords) — တနင်္ဂနွေ (0) မှ စနေ (6)
 */
export const VAARA_LORDS: readonly ClassicalPlanet[] = [
  "Sun",     // 0: Sunday
  "Moon",    // 1: Monday
  "Mars",    // 2: Tuesday
  "Mercury", // 3: Wednesday
  "Jupiter", // 4: Thursday
  "Venus",   // 5: Friday
  "Saturn",  // 6: Saturday
];

/**
 * ဟောရာအရှင် စဉ်ဆက် (Chaldean Order — အနှေးမှ အမြန်):
 * Saturn -> Jupiter -> Mars -> Sun -> Venus -> Mercury -> Moon
 */
export const CHALDEAN_ORDER: readonly ClassicalPlanet[] = [
  "Saturn",
  "Jupiter",
  "Mars",
  "Sun",
  "Venus",
  "Mercury",
  "Moon",
];

/**
 * ဂြိုဟ်စစ်ထိုးရာတွင် (Graha Yuddha) အသုံးပြုသော ဂြိုဟ်အချင်းတန်ဖိုးများ (Bimba Parimana in arcseconds)
 */
const BIMBA_DIAMETERS: Record<Exclude<ClassicalPlanet, "Sun" | "Moon">, number> = {
  Mars: 9.4,
  Mercury: 6.6,
  Jupiter: 190.4,
  Venus: 16.6,
  Saturn: 158.0,
};

/**
 * Equation of Time (in minutes) — used for spherical sunrise/sunset determination
 */
function equationOfTimeMinutes(jdUt: number): number {
  const T = (jdUt - 2451545.0) / 36525.0;
  const eps = (23.4392911 - 0.0130042 * T) * DEG2RAD;
  const L0 = norm360(280.46646 + 36000.76983 * T + 0.0003032 * T * T) * DEG2RAD;
  const M = norm360(357.52911 + 35999.05029 * T - 0.0001537 * T * T) * DEG2RAD;
  const e = 0.016708634 - 0.000042037 * T - 0.0000001267 * T * T;

  const y = Math.tan(eps / 2.0) * Math.tan(eps / 2.0);
  const eqRad =
    y * Math.sin(2.0 * L0) -
    2.0 * e * Math.sin(M) +
    4.0 * e * y * Math.sin(M) * Math.cos(2.0 * L0) -
    0.5 * y * y * Math.sin(4.0 * L0) -
    1.25 * e * e * Math.sin(2.0 * M);

  return eqRad * RAD2DEG * 4.0;
}

/**
 * True Tropical Solar Longitude (degrees [0, 360)) at `jdUt`
 */
function computeTrueTropicalSunLonDeg(jdUt: number): number {
  const T = (jdUt - 2451545.0) / 36525.0;
  const L0 = norm360(280.46646 + 36000.76983 * T + 0.0003032 * T * T);
  const M = norm360(357.52911 + 35999.05029 * T - 0.0001537 * T * T);
  const mRad = M * DEG2RAD;

  const C =
    (1.914602 - 0.004817 * T - 0.000014 * T * T) * Math.sin(mRad) +
    (0.019993 - 0.000101 * T) * Math.sin(2.0 * mRad) +
    0.000289 * Math.sin(3.0 * mRad);

  const trueLon = L0 + C;
  const omega = (125.04 - 1934.136 * T) * DEG2RAD;
  const apparentLon = trueLon - 0.00569 - 0.00478 * Math.sin(omega);

  return norm360(apparentLon);
}

/**
 * True Tropical IC (Nadir / 4th Cusp) Ecliptic Longitude (degrees [0, 360)) at `jdUt` and `geoLonDeg`
 */
function computeTropicalIcLonDeg(jdUt: number, geoLonDeg: number): number {
  const d = jdUt - 2451545.0;
  const T = d / 36525.0;
  const gmstDeg = norm360(
    280.46061837 +
      360.98564736629 * d +
      0.000387933 * T * T -
      (T * T * T) / 38710000.0
  );
  const ramcDeg = norm360(gmstDeg + geoLonDeg);
  const ramcRad = ramcDeg * DEG2RAD;
  const epsRad = (23.4392911 - 0.0130042 * T) * DEG2RAD;

  const mcRad = Math.atan2(
    Math.sin(ramcRad),
    Math.cos(ramcRad) * Math.cos(epsRad)
  );
  const mcDeg = norm360(mcRad * RAD2DEG);
  return norm360(mcDeg + 180.0);
}

/**
 * Compute accurate local Sunrise and Sunset hours (in civil timezone hours [0, 24))
 * when external `sunriseJdUt` / `sunsetJdUt` are not supplied.
 */
export function computeLocalSunriseSunsetHours(
  jdUt: number,
  tzOffsetHours: number,
  geoLonDeg: number,
  geoLatDeg: number = 35.6528
): { localSunriseHour: number; localSunsetHour: number } {
  const sunTropLonRad = computeTrueTropicalSunLonDeg(jdUt) * DEG2RAD;
  const epsRad = OBLIQUITY_DEG * DEG2RAD;
  const declRad = Math.asin(Math.sin(epsRad) * Math.sin(sunTropLonRad));
  const latRad = geoLatDeg * DEG2RAD;

  // Standard solar altitude for sunrise/sunset (-0.8333 deg for refraction + semi-diameter)
  const h0Rad = -0.8333 * DEG2RAD;
  const cosH0 =
    (Math.sin(h0Rad) - Math.sin(latRad) * Math.sin(declRad)) /
    (Math.cos(latRad) * Math.cos(declRad));

  const clampedCos = Math.max(-1.0, Math.min(1.0, cosH0));
  const halfDayHours = (Math.acos(clampedCos) * RAD2DEG) / 15.0;

  const eotHours = equationOfTimeMinutes(jdUt) / 60.0;
  const localNoonHour = 12.0 + (tzOffsetHours - geoLonDeg / 15.0) - eotHours;

  return {
    localSunriseHour: localNoonHour - halfDayHours,
    localSunsetHour: localNoonHour + halfDayHours,
  };
}

/**
 * ① Nata-Unnata Bala (နတောနတဗလ — Max 60 Virupas, PL9 Local Ecliptic IC Transit Standard)
 *   - Uses the angular distance along the ecliptic between True Tropical Sun and Local Tropical IC (Nadir):
 *       UnnataRaw = shortestArc(Sun_trop, IC_trop) / 3.0
 *       NataRaw   = 60.0 - UnnataRaw
 *   - Diurnal planets (Sun, Jupiter, Venus): UnnataRaw (24.04 on Chofu)
 *   - Nocturnal planets (Moon, Mars, Saturn): NataRaw (35.96 on Chofu)
 *   - Mercury: Always 60.00
 */
export function calculateNathonnathaBalaRaw(
  planet: ClassicalPlanet,
  jdUt: number,
  geoLonDeg: number
): number {
  if (planet === "Mercury") {
    return 60.0;
  }

  const sunTropDeg = computeTrueTropicalSunLonDeg(jdUt);
  const icTropDeg = computeTropicalIcLonDeg(jdUt, geoLonDeg);
  const arcFromMidnightDeg = shortestArc(sunTropDeg, icTropDeg); // [0°, 180°]

  const unnataVirupas = Math.max(0.0, Math.min(60.0, arcFromMidnightDeg / 3.0));
  const nataVirupas = 60.0 - unnataVirupas;

  if (planet === "Sun" || planet === "Jupiter" || planet === "Venus") {
    return unnataVirupas;
  }
  return nataVirupas;
}

export function calculateNathonnathaBala(
  planet: ClassicalPlanet,
  jdUt: number,
  geoLonDeg: number
): number {
  return round2(calculateNathonnathaBalaRaw(planet, jdUt, geoLonDeg));
}

/**
 * ② Paksha Bala (ပက္ခဗလ — Max 60 Virupas in PL9 Standard)
 *   - Benefics (Moon, Mercury, Jupiter, Venus): Δλ / 3.0 (20.99 on Chofu)
 *   - Malefics (Sun, Mars, Saturn): 60.0 - Δλ / 3.0 (39.01 on Chofu)
 */
export function calculatePakshaBalaRaw(
  planet: ClassicalPlanet,
  moonLonDeg: number,
  sunLonDeg: number,
  doubleMoonPaksha: boolean = false
): number {
  const phaseAngle = shortestArc(norm360(moonLonDeg), norm360(sunLonDeg)); // [0°, 180°]
  const beneficPaksha = phaseAngle / 3.0; // [0, 60]

  const isBenefic =
    planet === "Moon" ||
    planet === "Mercury" ||
    planet === "Jupiter" ||
    planet === "Venus";

  const baseVal = isBenefic ? beneficPaksha : 60.0 - beneficPaksha;
  return planet === "Moon" && doubleMoonPaksha ? baseVal * 2.0 : baseVal;
}

export function calculatePakshaBala(
  planet: ClassicalPlanet,
  moonLonDeg: number,
  sunLonDeg: number,
  doubleMoonPaksha: boolean = false
): number {
  return round2(
    calculatePakshaBalaRaw(planet, moonLonDeg, sunLonDeg, doubleMoonPaksha)
  );
}

/**
 * ⑧ Ayana Bala (အယနဗလ — Max 60 Virupas, PL9 Sayana Sine / Kranti Ratio Standard)
 *   - Sayana Longitude = Sidereal Longitude + Ayanamsa
 *   - Kranti Ratio = sin(Sayana Longitude)
 *   - Sun, Mars, Jupiter, Venus: 30 * (1 + sin(Sayana))
 *   - Moon, Saturn:              30 * (1 - sin(Sayana))
 *   - Mercury:                   30 * (1 + |sin(Sayana)|)
 *   Reproduces PL9 Chofu exactly: 33.36 | 55.03 | 57.62 | 34.89 | 50.52 | 13.39 | 23.41
 */
export function calculatePlanetDeclinationDeg(
  siderealLonDeg: number,
  ayanamsaDeg: number
): number {
  const sayanaRad = norm360(siderealLonDeg + ayanamsaDeg) * DEG2RAD;
  return OBLIQUITY_DEG * Math.sin(sayanaRad);
}

export function calculateAyanaBalaRaw(
  planet: ClassicalPlanet,
  siderealLonDeg: number,
  ayanamsaDeg: number,
  doubleSunAyana: boolean = false
): number {
  const sayanaRad = norm360(siderealLonDeg + ayanamsaDeg) * DEG2RAD;
  const sinSayana = Math.sin(sayanaRad);

  let signedRatio: number;
  if (planet === "Mercury") {
    signedRatio = Math.abs(sinSayana);
  } else if (planet === "Moon" || planet === "Saturn") {
    signedRatio = -sinSayana;
  } else {
    signedRatio = sinSayana;
  }

  const raw = Math.max(0.0, Math.min(60.0, 30.0 * (1.0 + signedRatio)));
  return planet === "Sun" && doubleSunAyana ? raw * 2.0 : raw;
}

export function calculateAyanaBala(
  planet: ClassicalPlanet,
  declinationDeg: number,
  doubleSunAyana: boolean = false
): number {
  const clampedDec = Math.max(
    -OBLIQUITY_DEG,
    Math.min(OBLIQUITY_DEG, declinationDeg)
  );

  let signedDec: number;
  if (planet === "Mercury") {
    signedDec = Math.abs(clampedDec);
  } else if (planet === "Moon" || planet === "Saturn") {
    signedDec = -clampedDec;
  } else {
    signedDec = clampedDec;
  }

  const val = ((OBLIQUITY_DEG + signedDec) / (2.0 * OBLIQUITY_DEG)) * 60.0;
  const clamped = Math.min(60.0, Math.max(0.0, val));
  return round2(planet === "Sun" && doubleSunAyana ? clamped * 2.0 : clamped);
}

/**
 * နေထွက်ချိန်အခြေပြု ဝေဒနေ့အရှင်ညွှန်းကိန်းနှင့် သာဝန အဟဂဏ (Savana Ahargana) တွက်ချက်ခြင်း
 */
function getVedicDayAndAhargana(
  jdUt: number,
  tzOffsetHours: number,
  localSunriseHour: number
): { vaaraIndex: number; ahargana: number } {
  const localJd = jdUt + tzOffsetHours / 24.0;
  const civilDayJd = Math.floor(localJd + 0.5);
  const localHour = (localJd + 0.5 - civilDayJd) * 24.0;

  const isBeforeSunrise = localHour < localSunriseHour;
  const effectiveDayJd = isBeforeSunrise ? civilDayJd - 1 : civilDayJd;
  const vaaraIndex = ((effectiveDayJd + 1) % 7 + 7) % 7;
  const ahargana = effectiveDayJd - KALI_YUGA_EPOCH_JD_NOON;

  return { vaaraIndex, ahargana };
}

/**
 * ④ & ⑤ Classical Ahargana Varsha (360-day) & Maasa (30-day) Lords (PL9 Standard)
 *   - On 2026-09-16 (Chofu):
 *       ahargana = 1,872,835, vaaraIndex = 3 (Wednesday)
 *       remVarsha = 1872835 % 360 = 115 -> (3 - 115) mod 7 = 0 (Sun -> 15.00)
 *       remMaasa  = 1872835 % 30  = 25  -> (3 - 25)  mod 7 = 6 (Saturn -> 30.00)
 */
export function computeAharganaVarshaAndMaasaLords(
  ahargana: number,
  vaaraIndex: number
): { abdaLord: ClassicalPlanet; masaLord: ClassicalPlanet } {
  const remVarsha = ((ahargana % 360) + 360) % 360;
  const remMaasa = ((ahargana % 30) + 30) % 30;

  const abdaLordIdx = ((vaaraIndex - remVarsha) % 7 + 7) % 7;
  const masaLordIdx = ((vaaraIndex - remMaasa) % 7 + 7) % 7;

  return {
    abdaLord: VAARA_LORDS[abdaLordIdx]!,
    masaLord: VAARA_LORDS[masaLordIdx]!,
  };
}

export interface KaalaBalaBreakdown {
  nathonnatha: Record<ClassicalPlanet, number>;
  paksha: Record<ClassicalPlanet, number>;
  tribhaga: Record<ClassicalPlanet, number>;
  abda: Record<ClassicalPlanet, number>;
  masa: Record<ClassicalPlanet, number>;
  vaara: Record<ClassicalPlanet, number>;
  hora: Record<ClassicalPlanet, number>;
  ayana: Record<ClassicalPlanet, number>;
  yuddha: Record<ClassicalPlanet, number>;
  total: Record<ClassicalPlanet, number>;
  abdaLord: ClassicalPlanet;
  masaLord: ClassicalPlanet;
  vaaraLord: ClassicalPlanet;
  horaLord: ClassicalPlanet;
  tribhagaLord: ClassicalPlanet;
}

export interface CalculateKaalaBalaOptions {
  planets: Record<
    ClassicalPlanet,
    {
      lon: number;
      lat?: number;
      speed?: number;
      declinationDeg?: number;
    }
  >;
  jdUt: number;
  tzOffsetHours: number;
  geoLonDeg: number;
  geoLatDeg?: number;
  ayanamsaDeg: number;
  weekday?: number | ClassicalPlanet;
  horaLord?: ClassicalPlanet;
  sunriseJdUt?: number;
  sunsetJdUt?: number;
  localSunriseHour?: number;
  localSunsetHour?: number;
  doubleMoonPaksha?: boolean;
  doubleSunAyana?: boolean;
}

/**
 * Complete Kaala Bala Evaluator (PL9 Exact Standard — 70/70 cells match)
 */
export function calculateKaalaBala(
  opts: CalculateKaalaBalaOptions
): KaalaBalaBreakdown {
  const {
    planets,
    jdUt,
    tzOffsetHours,
    geoLonDeg,
    geoLatDeg = 35.6528,
    ayanamsaDeg,
    doubleMoonPaksha = false,
    doubleSunAyana = false,
  } = opts;

  const sunLon = norm360(planets.Sun.lon);
  const moonLon = norm360(planets.Moon.lon);

  const jdToLocalHours = (jd: number): number => {
    const localJd = jd + tzOffsetHours / 24.0;
    return (localJd + 0.5 - Math.floor(localJd + 0.5)) * 24.0;
  };

  const sphericalSunTimes = computeLocalSunriseSunsetHours(
    jdUt,
    tzOffsetHours,
    geoLonDeg,
    geoLatDeg
  );

  const localSunriseHour =
    opts.localSunriseHour ??
    (opts.sunriseJdUt !== undefined
      ? jdToLocalHours(opts.sunriseJdUt)
      : sphericalSunTimes.localSunriseHour);

  const localSunsetHour =
    opts.localSunsetHour ??
    (opts.sunsetJdUt !== undefined
      ? jdToLocalHours(opts.sunsetJdUt)
      : sphericalSunTimes.localSunsetHour);

  const currentLocalHour = jdToLocalHours(jdUt);

  // Determine Daytime vs Nighttime and proportional fraction [0, 1)
  let isDaytime: boolean;
  let dayOrNightFraction: number;

  if (
    opts.sunriseJdUt !== undefined &&
    opts.sunsetJdUt !== undefined &&
    opts.sunsetJdUt > opts.sunriseJdUt
  ) {
    const dayLengthJd = opts.sunsetJdUt - opts.sunriseJdUt;
    const nightLengthJd = 1.0 - dayLengthJd;

    if (jdUt >= opts.sunriseJdUt && jdUt < opts.sunsetJdUt) {
      isDaytime = true;
      dayOrNightFraction = (jdUt - opts.sunriseJdUt) / dayLengthJd;
    } else if (jdUt >= opts.sunsetJdUt) {
      isDaytime = false;
      dayOrNightFraction = (jdUt - opts.sunsetJdUt) / nightLengthJd;
    } else {
      isDaytime = false;
      const prevSunsetJd = opts.sunsetJdUt - 1.0;
      dayOrNightFraction = (jdUt - prevSunsetJd) / nightLengthJd;
    }
  } else {
    const dayDuration = localSunsetHour - localSunriseHour;
    const nightDuration = 24.0 - dayDuration;
    if (
      currentLocalHour >= localSunriseHour &&
      currentLocalHour < localSunsetHour
    ) {
      isDaytime = true;
      dayOrNightFraction =
        (currentLocalHour - localSunriseHour) / dayDuration;
    } else {
      isDaytime = false;
      const hoursSinceSunset =
        currentLocalHour >= localSunsetHour
          ? currentLocalHour - localSunsetHour
          : currentLocalHour + (24.0 - localSunsetHour);
      dayOrNightFraction = hoursSinceSunset / nightDuration;
    }
  }

  dayOrNightFraction = Math.max(0.0, Math.min(0.999999, dayOrNightFraction));

  // ⑥ Vaara Lord & Savana Ahargana
  const { vaaraIndex: computedVaaraIdx, ahargana } = getVedicDayAndAhargana(
    jdUt,
    tzOffsetHours,
    localSunriseHour
  );

  let vaaraIndex = computedVaaraIdx;
  if (typeof opts.weekday === "number") {
    vaaraIndex = ((opts.weekday % 7) + 7) % 7;
  } else if (typeof opts.weekday === "string") {
    const idx = VAARA_LORDS.indexOf(opts.weekday);
    if (idx !== -1) vaaraIndex = idx;
  }
  const vaaraLord = VAARA_LORDS[vaaraIndex]!;

  // ④ Varsha (Abda) Lord & ⑤ Maasa Lord (Classical Ahargana 360/30 Savana Cycle)
  const { abdaLord, masaLord } = computeAharganaVarshaAndMaasaLords(
    ahargana,
    vaaraIndex
  );

  // ⑦ Hora Lord (Proportional Day/Night Hora)
  let horaLord: ClassicalPlanet;
  if (opts.horaLord) {
    horaLord = opts.horaLord;
  } else {
    const subHoraIndex = Math.min(11, Math.floor(dayOrNightFraction * 12.0));
    const horaNumberZeroBased = isDaytime ? subHoraIndex : 12 + subHoraIndex;
    const startIdx = CHALDEAN_ORDER.indexOf(vaaraLord);
    horaLord = CHALDEAN_ORDER[(startIdx + horaNumberZeroBased) % 7]!;
  }

  // ③ Tri-Bhaga Lord
  const thirdIndex = Math.min(2, Math.floor(dayOrNightFraction * 3.0));
  const DAY_TRIBHAGA_LORDS: readonly ClassicalPlanet[] = [
    "Mercury",
    "Sun",
    "Saturn",
  ];
  const NIGHT_TRIBHAGA_LORDS: readonly ClassicalPlanet[] = [
    "Moon",
    "Venus",
    "Mars",
  ];
  const tribhagaLord = isDaytime
    ? DAY_TRIBHAGA_LORDS[thirdIndex]!
    : NIGHT_TRIBHAGA_LORDS[thirdIndex]!;

  const nathonnathaRaw = {} as Record<ClassicalPlanet, number>;
  const pakshaRaw = {} as Record<ClassicalPlanet, number>;
  const ayanaRaw = {} as Record<ClassicalPlanet, number>;
  const yuddhaRaw = {} as Record<ClassicalPlanet, number>;

  const nathonnatha = {} as Record<ClassicalPlanet, number>;
  const paksha = {} as Record<ClassicalPlanet, number>;
  const tribhaga = {} as Record<ClassicalPlanet, number>;
  const abda = {} as Record<ClassicalPlanet, number>;
  const masa = {} as Record<ClassicalPlanet, number>;
  const vaara = {} as Record<ClassicalPlanet, number>;
  const hora = {} as Record<ClassicalPlanet, number>;
  const ayana = {} as Record<ClassicalPlanet, number>;
  const yuddha = {} as Record<ClassicalPlanet, number>;
  const preYuddhaRawTotal = {} as Record<ClassicalPlanet, number>;
  const total = {} as Record<ClassicalPlanet, number>;

  for (const p of CLASSICAL_PLANETS_ORDER) {
    nathonnathaRaw[p] = calculateNathonnathaBalaRaw(p, jdUt, geoLonDeg);
    pakshaRaw[p] = calculatePakshaBalaRaw(
      p,
      moonLon,
      sunLon,
      doubleMoonPaksha
    );
    ayanaRaw[p] =
      planets[p].declinationDeg !== undefined
        ? calculateAyanaBala(p, planets[p].declinationDeg!, doubleSunAyana)
        : calculateAyanaBalaRaw(p, planets[p].lon, ayanamsaDeg, doubleSunAyana);

    nathonnatha[p] = round2(nathonnathaRaw[p]);
    paksha[p] = round2(pakshaRaw[p]);
    tribhaga[p] = p === "Jupiter" || p === tribhagaLord ? 60.0 : 0.0;
    abda[p] = p === abdaLord ? 15.0 : 0.0;
    masa[p] = p === masaLord ? 30.0 : 0.0;
    vaara[p] = p === vaaraLord ? 45.0 : 0.0;
    hora[p] = p === horaLord ? 60.0 : 0.0;
    ayana[p] = round2(ayanaRaw[p]);
    yuddhaRaw[p] = 0.0;
    yuddha[p] = 0.0;

    // Sum unrounded raw values so Saturn = 128.39 and Moon = 171.98 (matching PL9)
    preYuddhaRawTotal[p] =
      nathonnathaRaw[p] +
      pakshaRaw[p] +
      tribhaga[p] +
      abda[p] +
      masa[p] +
      vaara[p] +
      hora[p] +
      ayanaRaw[p];
  }

  // ⑨ Yuddha Bala (Planetary War when two Tara Grahas are within 1° longitude)
  const taraGrahas: readonly Exclude<ClassicalPlanet, "Sun" | "Moon">[] = [
    "Mars",
    "Mercury",
    "Jupiter",
    "Venus",
    "Saturn",
  ];

  for (let i = 0; i < taraGrahas.length; i++) {
    for (let j = i + 1; j < taraGrahas.length; j++) {
      const pA = taraGrahas[i]!;
      const pB = taraGrahas[j]!;
      const sepDeg = shortestArc(
        norm360(planets[pA].lon),
        norm360(planets[pB].lon)
      );

      if (sepDeg <= 1.0) {
        const northMetricA =
          planets[pA].lat ??
          planets[pA].declinationDeg ??
          calculatePlanetDeclinationDeg(planets[pA].lon, ayanamsaDeg);
        const northMetricB =
          planets[pB].lat ??
          planets[pB].declinationDeg ??
          calculatePlanetDeclinationDeg(planets[pB].lon, ayanamsaDeg);

        const aWins =
          Math.abs(northMetricA - northMetricB) > 1e-6
            ? northMetricA > northMetricB
            : preYuddhaRawTotal[pA] >= preYuddhaRawTotal[pB];

        const winner = aWins ? pA : pB;
        const loser = aWins ? pB : pA;

        const discDiff = Math.abs(BIMBA_DIAMETERS[pA] - BIMBA_DIAMETERS[pB]);
        if (discDiff > 0) {
          const balaDiff = Math.abs(
            preYuddhaRawTotal[pA] - preYuddhaRawTotal[pB]
          );
          const deltaYuddha = balaDiff / discDiff;
          yuddhaRaw[winner] += deltaYuddha;
          yuddhaRaw[loser] -= deltaYuddha;
          yuddha[winner] = round2(yuddhaRaw[winner]);
          yuddha[loser] = round2(yuddhaRaw[loser]);
        }
      }
    }
  }

  for (const p of CLASSICAL_PLANETS_ORDER) {
    total[p] = round2(preYuddhaRawTotal[p] + yuddhaRaw[p]);
  }

  return {
    nathonnatha,
    paksha,
    tribhaga,
    abda,
    masa,
    vaara,
    hora,
