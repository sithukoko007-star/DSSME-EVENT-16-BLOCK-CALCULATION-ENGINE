export type DrigBalaMode =
  | "DEGREE_RAMAN_BAND"
  | "BPHS_CLASSICAL"
  | "PL9_EXACT_OVERRIDE";

export function evaluateBaseDrishtiVirupas(dkDeg: number): number {
  const dk = norm360(dkDeg);
  if (dk < 30.0 || dk >= 300.0) {
    return 0.0;
  }
  if (dk < 60.0) {
    return (dk - 30.0) / 2.0; // 0 -> 15
  }
  if (dk < 90.0) {
    return dk - 45.0; // 15 -> 45
  }
  if (dk < 120.0) {
    return 45.0 - (dk - 90.0) / 2.0; // 45 -> 30
  }
  if (dk < 150.0) {
    return 150.0 - dk; // 30 -> 0
  }
  if (dk < 180.0) {
    return (dk - 150.0) * 2.0; // 0 -> 60
  }
  return (300.0 - dk) / 2.0; // 60 -> 0
}

export function evaluateVisheshaDrishtiBonus(
  aspectingPlanet: ClassicalPlanet,
  dkDeg: number
): number {
  const dk = norm360(dkDeg);
  if (aspectingPlanet === "Mars") {
    if ((dk >= 90.0 && dk < 120.0) || (dk >= 210.0 && dk < 240.0)) {
      return 15.0;
    }
  } else if (aspectingPlanet === "Jupiter") {
    if ((dk >= 120.0 && dk < 150.0) || (dk >= 240.0 && dk < 270.0)) {
      return 30.0;
    }
  } else if (aspectingPlanet === "Saturn") {
    if ((dk >= 60.0 && dk < 90.0) || (dk >= 270.0 && dk < 300.0)) {
      return 45.0;
    }
  }
  return 0.0;
}

export function calculateDrigBala(
  planets: Record<ClassicalPlanet, { lon: number }>,
  mode: DrigBalaMode = "DEGREE_RAMAN_BAND",
  drigBalaOverride?: Partial<Record<ClassicalPlanet, number>>
): Record<ClassicalPlanet, number> {
  const result = {} as Record<ClassicalPlanet, number>;

  const isBenefic = (p: ClassicalPlanet): boolean =>
    p === "Moon" || p === "Mercury" || p === "Jupiter" || p === "Venus";

  for (const target of CLASSICAL_PLANETS_ORDER) {
    if (
      drigBalaOverride &&
      typeof drigBalaOverride[target] === "number" &&
      !Number.isNaN(drigBalaOverride[target])
    ) {
      result[target] = round2(drigBalaOverride[target]!);
      continue;
    }

    let netDrig = 0.0;
    const targetLon = norm360(planets[target].lon);

    for (const from of CLASSICAL_PLANETS_ORDER) {
      if (from === target) continue;
      const fromLon = norm360(planets[from].lon);
      const dk = norm360(targetLon - fromLon);

      const baseVirupas = evaluateBaseDrishtiVirupas(dk);
      if (baseVirupas <= 0.0) continue;

      const visheshaBonus = evaluateVisheshaDrishtiBonus(from, dk);
      const totalPairAspect =
        mode === "BPHS_CLASSICAL"
          ? (baseVirupas + visheshaBonus) / 4.0
          : baseVirupas / 4.0 + visheshaBonus / 4.0;

      const sign = isBenefic(from) ? +1.0 : -1.0;
      netDrig += sign * totalPairAspect;
    }

    result[target] = round2(netDrig);
  }

  return result;
}

