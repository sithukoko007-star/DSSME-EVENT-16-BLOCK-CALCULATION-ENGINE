export function computeDailySpeedFromLongitudes(
  lonDay1: number,
  lonDay2: number
): number {
  return round4(wrapSigned180(lonDay2 - lonDay1));
}

export function computeEpochTableMeanAndSeeghrocha(
  planet: TaraGrahaId,
  ctx: ChestaEpochContext
): { meanLonDeg: number; seeghrochaLonDeg: number; intervalDays: number } {
  const localJd =
    typeof ctx.localJulianDay === "number" && !Number.isNaN(ctx.localJulianDay)
      ? ctx.localJulianDay
      : (ctx.jdUt ?? 2451545.0) + (ctx.tzOffsetHours ?? 0.0) / 24.0;

  const placeLon = ctx.placeLongitude ?? UJJAIN_LONGITUDE_DEG;
  const desantaraDays = (UJJAIN_LONGITUDE_DEG - placeLon) / 360.0;
  const intervalDays = localJd - CHESTA_EPOCH_JD_1900 + desantaraDays;
  const elapsedYears = intervalDays / 365.25;

  const sunCfg = EPOCH_1900_TABLE.Sun;
  const meanSunLon = norm360(
    sunCfg.epochLonDeg +
      intervalDays * sunCfg.dailyMotionDeg +
      sunCfg.secularCorrectionDeg(elapsedYears)
  );

  const pCfg = EPOCH_1900_TABLE[planet];
  const planetTabularLon = norm360(
    pCfg.epochLonDeg +
      intervalDays * pCfg.dailyMotionDeg +
      pCfg.secularCorrectionDeg(elapsedYears)
  );

  if (planet === "Mercury" || planet === "Venus") {
    return {
      meanLonDeg: round4(meanSunLon),
      seeghrochaLonDeg: round4(planetTabularLon),
      intervalDays: round4(intervalDays),
    };
  }

  return {
    meanLonDeg: round4(planetTabularLon),
    seeghrochaLonDeg: round4(meanSunLon),
    intervalDays: round4(intervalDays),
  };
}

export function calculateMethod1ChestaKendraBala(
  trueLonDeg: number,
  meanLonDeg: number,
  seeghrochaLonDeg: number,
  averageMode: "LINEAR_MOD360" | "CIRCULAR_SHORT" = "LINEAR_MOD360"
): {
  avgLonDeg: number;
  chestaKendraDeg: number;
  chestaBalaVirupas: number;
  chestaBalaRupas: number;
} {
  const meanNorm = norm360(meanLonDeg);
  const trueNorm = norm360(trueLonDeg);

  const avgLonDeg =
    averageMode === "CIRCULAR_SHORT"
      ? norm360(meanNorm + wrapSigned180(trueNorm - meanNorm) / 2.0)
      : norm360((meanNorm + trueNorm) / 2.0);

  const chestaKendraDeg = shortestArc(norm360(seeghrochaLonDeg), avgLonDeg);
  const chestaBalaVirupas = round2(
    Math.max(0.0, Math.min(60.0, chestaKendraDeg / 3.0))
  );

  return {
    avgLonDeg: round4(avgLonDeg),
    chestaKendraDeg: round4(chestaKendraDeg),
    chestaBalaVirupas,
    chestaBalaRupas: round4(chestaBalaVirupas / 60.0),
  };
}

export function classifyTaraGrahaAshtaGati(
  input: ChestaPlanetInput & { planet: TaraGrahaId },
  thresholds: AshtaGatiThresholds = DEFAULT_ASHTA_GATI_THRESHOLDS
): {
  gatiState: AshtaGatiState;
  dailySpeedDeg: number;
  meanSpeedDeg: number;
  speedRatio: number;
  isRetrograde: boolean;
  currentRasi: RasiIndex;
} {
  const dailySpeedDeg =
    typeof input.lonDay2 === "number" && !Number.isNaN(input.lonDay2)
      ? computeDailySpeedFromLongitudes(input.lon, input.lonDay2)
      : input.speed;

  const meanSpeedDeg = TARA_MEAN_DAILY_SPEED_DEG[input.planet];
  const speedRatio = dailySpeedDeg / meanSpeedDeg;
  const absSpeed = Math.abs(dailySpeedDeg);
  const absRatio = Math.abs(speedRatio);
  const isRetrograde = Boolean(input.retro) || dailySpeedDeg < 0;

  const currentRasi = Math.floor(norm360(input.lon) / 30.0) as RasiIndex;
  const stationRasi =
    typeof input.stationRetrogradeLon === "number" &&
    !Number.isNaN(input.stationRetrogradeLon)
      ? (Math.floor(norm360(input.stationRetrogradeLon) / 30.0) as RasiIndex)
      : undefined;

  if (
    absRatio < thresholds.vikalaMaxRatio ||
    absSpeed < thresholds.vikalaMaxAbsSpeedDeg
  ) {
    return {
      gatiState: "Vikala",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde,
      currentRasi,
    };
  }

  if (isRetrograde) {
    const crossedIntoPreviousSign =
      input.isAnuvakra === true ||
      (stationRasi !== undefined && stationRasi !== currentRasi);

    return {
      gatiState: crossedIntoPreviousSign ? "Anuvakra" : "Vakra",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde: true,
      currentRasi,
    };
  }

  if (speedRatio < thresholds.mandataraMaxRatio) {
    return {
      gatiState: "Mandatara",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde: false,
      currentRasi,
    };
  }

  if (speedRatio < thresholds.mandaMaxRatio) {
    return {
      gatiState: "Manda",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde: false,
      currentRasi,
    };
  }

  if (speedRatio <= thresholds.samaMaxRatio) {
    return {
      gatiState: "Sama",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde: false,
      currentRasi,
    };
  }

  if (input.isAtichara === true || speedRatio > thresholds.charaMaxRatio) {
    return {
      gatiState: "Atichara",
      dailySpeedDeg,
      meanSpeedDeg,
      speedRatio: round4(speedRatio),
      isRetrograde: false,
      currentRasi,
    };
  }

  return {
    gatiState: "Chara",
    dailySpeedDeg,
    meanSpeedDeg,
    speedRatio: round4(speedRatio),
    isRetrograde: false,
    currentRasi,
  };
}

export function evaluatePlanetChestaBala(
  pos: ChestaPlanetInput,
  sunAyanaBala: number,
  unDoubledMoonPakshaBala: number,
  mode: ChestaBalaMode = "METHOD_1_KENDRA",
  thresholds: AshtaGatiThresholds = DEFAULT_ASHTA_GATI_THRESHOLDS,
  epochCtx?: ChestaEpochContext
): PlanetChestaBalaDetail {
  const currentRasi = Math.floor(norm360(pos.lon) / 30.0) as RasiIndex;

  if (pos.planet === "Sun") {
    const virupas = round2(Math.max(0.0, Math.min(60.0, sunAyanaBala)));
    return {
      planet: "Sun",
      mode,
      gatiState: "AyanaBalaProxy",
      dailySpeedDeg: pos.speed,
      meanSpeedDeg: 0.9856,
      speedRatio: round4(pos.speed / 0.9856),
      isRetrograde: false,
      currentRasi,
      chestaBalaVirupas: virupas,
      chestaBalaRupas: round4(virupas / 60.0),
    };
  }

  if (pos.planet === "Moon") {
    const virupas = round2(
      Math.max(0.0, Math.min(60.0, unDoubledMoonPakshaBala))
    );
    return {
      planet: "Moon",
      mode,
      gatiState: "PakshaBalaProxy",
      dailySpeedDeg: pos.speed,
      meanSpeedDeg: 13.1764,
      speedRatio: round4(pos.speed / 13.1764),
      isRetrograde: false,
      currentRasi,
      chestaBalaVirupas: virupas,
      chestaBalaRupas: round4(virupas / 60.0),
    };
  }

  const taraPos = pos as ChestaPlanetInput & { planet: TaraGrahaId };
  const classified = classifyTaraGrahaAshtaGati(taraPos, thresholds);

  if (mode === "METHOD_1_KENDRA") {
    const hasManualMeanAndSeeghra =
      typeof pos.meanLon === "number" &&
      !Number.isNaN(pos.meanLon) &&
      typeof pos.seeghrochaLon === "number" &&
      !Number.isNaN(pos.seeghrochaLon);

    const { meanLonDeg, seeghrochaLonDeg } = hasManualMeanAndSeeghra
      ? { meanLonDeg: pos.meanLon!, seeghrochaLonDeg: pos.seeghrochaLon! }
      : computeEpochTableMeanAndSeeghrocha(taraPos.planet, epochCtx ?? {});

    const kendraOut = calculateMethod1ChestaKendraBala(
      pos.lon,
      meanLonDeg,
      seeghrochaLonDeg,
      epochCtx?.averageMode ?? "LINEAR_MOD360"
    );

    return {
      planet: pos.planet,
      mode,
      gatiState: classified.gatiState,
      dailySpeedDeg: classified.dailySpeedDeg,
      meanSpeedDeg: classified.meanSpeedDeg,
      speedRatio: classified.speedRatio,
      isRetrograde: classified.isRetrograde,
      currentRasi: classified.currentRasi,
      meanLonDeg,
      seeghrochaLonDeg,
      chestaKendraDeg: kendraOut.chestaKendraDeg,
      chestaBalaVirupas: kendraOut.chestaBalaVirupas,
      chestaBalaRupas: kendraOut.chestaBalaRupas,
    };
  }

  const virupaTable =
    mode === "MODERN_SOFTWARE"
      ? ASHTA_GATI_VIRUPAS_MODERN_VARIANT
      : ASHTA_GATI_VIRUPAS_BPHS_ORIGINAL;

  const chestaBalaVirupas = virupaTable[classified.gatiState];

  return {
    planet: pos.planet,
    mode,
    gatiState: classified.gatiState,
    dailySpeedDeg: classified.dailySpeedDeg,
    meanSpeedDeg: classified.meanSpeedDeg,
    speedRatio: classified.speedRatio,
    isRetrograde: classified.isRetrograde,
    currentRasi: classified.currentRasi,
    chestaBalaVirupas,
    chestaBalaRupas: round4(chestaBalaVirupas / 60.0),
  };
}

export function calculateChestaBala(
  pos: ChestaPlanetInput,
  sunAyanaBala: number,
  unDoubledMoonPakshaBala: number,
  mode: ChestaBalaMode = "METHOD_1_KENDRA",
  epochCtx?: ChestaEpochContext
): number {
  return evaluatePlanetChestaBala(
    pos,
    sunAyanaBala,
    unDoubledMoonPakshaBala,
    mode,
    DEFAULT_ASHTA_GATI_THRESHOLDS,
    epochCtx
  ).chestaBalaVirupas;
}

