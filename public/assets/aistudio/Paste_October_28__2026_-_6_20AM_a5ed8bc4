// SUITE 4: MODE ISOLATION (PL9 vs BPHS) & DSSME v1.6 STAGE S6 SIF_v3 INVARIANTS
// ============================================================================

function testModeIsolationAndDssmeV16Invariants(): void {
  // 1. Compare pl9ParityMode: true vs pl9ParityMode: false on Drig Bala & Paksha Bala
  const bphsOut = calculateShadbala({
    planets: CHOFU_PLANETS,
    jdUt: CHOFU_JD_UT,
    tzOffsetHours: CHOFU_TZ_OFFSET,
    geoLonDeg: CHOFU_LON,
    geoLatDeg: CHOFU_LAT,
    ayanamsaDeg: CHOFU_AYANAMSA,
    usePanchadhaSaptavargaja: true,
    pl9ParityMode: false,
    drigMode: "DEGREE_CONTINUOUS_KNOT",
    drigWeightingMode: "BPHS_EQUAL_DIV_4",
  });

  // In BPHS mode, Moon's Paksha Bala is doubled (20.99 * 2 = 41.98)
  assertApprox(
    bphsOut.results.Moon.kaalaBreakdown.paksha,
    41.98,
    0.02,
    "BPHS mode doubles Moon Paksha Bala (Sloka 10)"
  );

  // In BPHS mode (/4 for all planets), Saturn Drig Bala is 19.4 (vs 106.62 in PL9 mode)
  assertApprox(
    bphsOut.results.Saturn.drig,
    19.4,
    0.1,
    "BPHS mode divides Jupiter & Mercury aspects by 4"
  );

  // Jupiter receives no aspect from Mercury or itself, so Jupiter Drig Bala is 0.60 in BOTH modes
  assertApprox(
    bphsOut.results.Jupiter.drig,
    0.6,
    0.05,
    "Jupiter Drig Bala is 0.60 in both PL9 and BPHS modes"
  );

  // 2. Verify DSSME Master Contract v1.6 Stage S6 (SIF_v3) DIF classification on PL9 Drig Bala
  const pl9Drig = calculateDetailedDrigBala(CHOFU_PLANETS, {
    mode: "DEGREE_CONTINUOUS_KNOT",
    weightingMode: "PL9_JUP_MERC_FULL",
  }).virupasByPlanet;

  const computeDif = (drigBala: number): number => {
    if (drigBala >= 0) return 1.0;
    if (drigBala >= -20) return 0.95;
    return 0.85;
  };

  assert.equal(computeDif(pl9Drig.Sun), 0.95, "Sun (-5.67) -> DIF 0.95");
  assert.equal(computeDif(pl9Drig.Moon), 1.0, "Moon (+37.79) -> DIF 1.00");
  assert.equal(computeDif(pl9Drig.Mars), 1.0, "Mars (+11.19) -> DIF 1.00");
  assert.equal(computeDif(pl9Drig.Mercury), 0.95, "Mercury (-11.98) -> DIF 0.95");
  assert.equal(computeDif(pl9Drig.Jupiter), 1.0, "Jupiter (+0.60) -> DIF 1.00");
  assert.equal(computeDif(pl9Drig.Venus), 1.0, "Venus (+5.80) -> DIF 1.00");
  assert.equal(computeDif(pl9Drig.Saturn), 1.0, "Saturn (+106.62) -> DIF 1.00");
}

