const OBLIQUITY_DEG = 23.4393;
const OBLIQUITY_RAD = (OBLIQUITY_DEG * Math.PI) / 180;

// ============================================================================
// MATHEMATICAL & ASTRONOMICAL HELPERS
// ============================================================================

export function norm360(lon: number): number {
  return ((lon % 360) + 360) % 360;
}

export function shortestArc(lonA: number, lonB: number): number {
  const diff = Math.abs(norm360(lonA - lonB));
  return diff > 180 ? 360 - diff : diff;
}

function round1(val: number): number {
  return Math.round((val + Number.EPSILON) * 10) / 10;
}

function round2(val: number): number {
  return Math.round((val + Number.EPSILON) * 100) / 100;
}

function round4(val: number): number {
  return Math.round((val + Number.EPSILON) * 10000) / 10000;
}

function equationOfTimeMinutes(julianDayUt: number): number {
  const jd0 = Math.floor(julianDayUt - 0.5) + 0.5;
  const year = new Date((julianDayUt - 2440587.5) * 86400000).getUTCFullYear();
  const jan1Jd = 2440587.5 + Date.UTC(year, 0, 1) / 86400000;
  const N = Math.round(jd0 - jan1Jd) + 1;
  const B = (2 * Math.PI * (N - 81)) / 364;
  return 9.87 * Math.sin(2 * B) - 7.53 * Math.cos(B) - 1.5 * Math.sin(B);
}

/**
 * Computes the astronomical Sidereal Midheaven (MC / 10th Cusp) and Nadir (IC / 4th Cusp)
 * from Julian Day (UT), geographic longitude, and Ayanamsa.
 */
export function computeAstronomicalMcIcSidereal(
  jdUt: number,
  geoLonDeg: number,
  ayanamsaDeg: number
): { mcSiderealLon: number; icSiderealLon: number } {
  const T = (jdUt - 2451545.0) / 36525.0;
  const gmstDeg = norm360(
    280.46061837 +
      360.98564736629 * (jdUt - 2451545.0) +
      0.000387933 * T * T -
      (T * T * T) / 38710000.0
  );
  const ramcDeg = norm360(gmstDeg + geoLonDeg);
  const ramcRad = (ramcDeg * Math.PI) / 180.0;

  const mcTropicalRad = Math.atan2(
    Math.sin(ramcRad),
    Math.cos(ramcRad) * Math.cos(OBLIQUITY_RAD)
  );
  const mcTropicalDeg = norm360((mcTropicalRad * 180.0) / Math.PI);
  const mcSiderealLon = norm360(mcTropicalDeg - ayanamsaDeg);
  const icSiderealLon = norm360(mcSiderealLon + 180.0);

  return { mcSiderealLon, icSiderealLon };
}

/**
 * Computes local astronomical sunrise and sunset hours (in local timezone hours [0, 24))
 * from Julian Day (UT), latitude, longitude, timezone offset, and Sun tropical longitude.
 */
export function computeLocalSunriseSunsetHours(
  jdUt: number,
  geoLatDeg: number,
  geoLonDeg: number,
  tzOffsetHours: number,
  sunTropicalLonDeg: number
): { localSunriseHour: number; localSunsetHour: number } {
  const eotHours = equationOfTimeMinutes(jdUt) / 60.0;
  const localApparentNoonHour =
    12.0 + tzOffsetHours - geoLonDeg / 15.0 - eotHours;

  const latRad = (geoLatDeg * Math.PI) / 180.0;
  const sunTropRad = (norm360(sunTropicalLonDeg) * Math.PI) / 180.0;
  const sinDec = Math.sin(OBLIQUITY_RAD) * Math.sin(sunTropRad);
  const decRad = Math.asin(Math.max(-1, Math.min(1, sinDec)));

  const cosH0 = -Math.tan(latRad) * Math.tan(decRad);
  const clampedCosH0 = Math.max(-1, Math.min(1, cosH0));
  const halfDayHours = ((Math.acos(clampedCosH0) * 180.0) / Math.PI) / 15.0;

  return {
    localSunriseHour: Math.max(0, Math.min(12, localApparentNoonHour - halfDayHours)),
    localSunsetHour: Math.max(12, Math.min(24, localApparentNoonHour + halfDayHours)),
  };
}

