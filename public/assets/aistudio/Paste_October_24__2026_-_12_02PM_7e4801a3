    doubleMoonPaksha: false, // PL9 standard တွင် 1x (Chesta နှင့် Paksha နှစ်နေရာခွဲယူသည်)၊ BPHS Dvigunam လိုအပ်ပါက true ထားပါ
    doubleSunAyana: false,
    usePanchadhaSaptavargaja: true,
    drigMode: "DEGREE_RAMAN_BAND",
  };

```

