new file mode 100644
index 0000000..cc41daf
--- /dev/null
+++ b/src/engine/blocks/dignityTables.ts
@@ -0,0 +1,107 @@
+/**
+ * DIGNITY tables and the single-planet dignity function (Level 2).
+ *
+ * Frozen decisions (owner, 2026-10-03 — see reports/PHASE_3_DECISION_LOG.md):
+ *   S-01  closed: Natural Friendship ONLY. No temporary / compound / tatkalika friendship.
+ *   S-01b closed: precedence  Exalted > Moolatrikona > Own > (Debilitated) > natural Friend / Neutral / Enemy.
+ *         `Grt.Friend` / `Grt.Enemy` are UNREACHABLE under natural-only and are never emitted.
+ *         Moolatrikona degree ranges are the PyJHora const.moola_trikona_range_of_planets values.
+ *         Exalted wins over Moolatrikona inside the same sign (Moon/Taurus, Mercury/Virgo).
+ *         Mercury in Virgo is EXALTED (DSSME spec) — a PyJHora Compatibility Exception (PyJHora: Owner).
+ *
+ * Sources (PyJHora @ 48e57d29b47a3143519910a24866758116467485, const.py):
+ *   house_strengths_of_planets  (4 = exalted sign, 0 = debilitated sign, 5 = own)
+ *   _friendly_planets / _neutral_planets / _enemy_planets  == DSSME Master Contract §9.2 (7x7, 0 mismatches)
+ *   moola_trikona_range_of_planets
+ * Moolatrikona ranges are applied half-open [from, to): the PyJHora range table has no consumer in the
+ * inspected modules, so inclusivity is a DSSME implementation choice (matches PyJHora's own half-open
+ * Pushkara test style).
+ */
+
+import type { ClassicalPlanet, Dignity, NineBody, ZodiacSign } from "../../types/dssme-canonical-types.ts";
+import { SIGN_LORDS } from "../astronomy/planetaryPositions.ts";
+
+export type ClassicalDignity = Exclude<Dignity, "Grt.Friend" | "Grt.Enemy" | "—">;
+export type NaturalRelation = "Friend" | "Neutral" | "Enemy";
+
+export const EXALTATION_SIGN: Readonly<Record<ClassicalPlanet, ZodiacSign>> = {
+  Sun: "Aries",
+  Moon: "Taurus",
+  Mars: "Capricorn",
+  Mercury: "Virgo", // DSSME spec: "Exalted for Mercury is Virgo only" (PyJHora matrix: Owner)
+  Jupiter: "Cancer",
+  Venus: "Pisces",
+  Saturn: "Libra",
+};
+
+export const DEBILITATION_SIGN: Readonly<Record<ClassicalPlanet, ZodiacSign>> = {
+  Sun: "Libra",
+  Moon: "Scorpio",
+  Mars: "Cancer",
+  Mercury: "Pisces",
+  Jupiter: "Capricorn",
+  Venus: "Virgo",
+  Saturn: "Aries",
+};
+
+export interface MoolatrikonaRange {
+  readonly sign: ZodiacSign;
+  readonly fromDeg: number;
+  readonly toDeg: number;
+}
+
+export const MOOLATRIKONA: Readonly<Record<ClassicalPlanet, MoolatrikonaRange>> = {
+  Sun: { sign: "Leo", fromDeg: 0, toDeg: 20 },
+  Moon: { sign: "Taurus", fromDeg: 3, toDeg: 30 },
+  Mars: { sign: "Aries", fromDeg: 0, toDeg: 12 },
+  Mercury: { sign: "Virgo", fromDeg: 15, toDeg: 20 },
+  Jupiter: { sign: "Sagittarius", fromDeg: 0, toDeg: 10 },
+  Venus: { sign: "Libra", fromDeg: 0, toDeg: 15 },
+  Saturn: { sign: "Aquarius", fromDeg: 0, toDeg: 20 },
+};
+
+/** DSSME Master Contract §9.2 Natural Planetary Friendship Table. Neutral = every other classical planet. */
+export const NATURAL_FRIENDS: Readonly<Record<ClassicalPlanet, readonly ClassicalPlanet[]>> = {
+  Sun: ["Moon", "Mars", "Jupiter"],
+  Moon: ["Sun", "Mercury"],
+  Mars: ["Sun", "Moon", "Jupiter"],
+  Mercury: ["Sun", "Venus"],
+  Jupiter: ["Sun", "Moon", "Mars"],
+  Venus: ["Mercury", "Saturn"],
+  Saturn: ["Mercury", "Venus"],
+};
+
+export const NATURAL_ENEMIES: Readonly<Record<ClassicalPlanet, readonly ClassicalPlanet[]>> = {
+  Sun: ["Venus", "Saturn"],
+  Moon: [],
+  Mars: ["Mercury"],
+  Mercury: ["Moon"],
+  Jupiter: ["Mercury", "Venus"],
+  Venus: ["Sun", "Moon"],
+  Saturn: ["Sun", "Moon", "Mars"],
+};
+
+/** Type guard: the seven classical planets (everything except Rahu / Ketu). */
+export function isClassicalPlanet(body: NineBody): body is ClassicalPlanet {
+  return body !== "Rahu" && body !== "Ketu";
+}
+
+export function naturalRelation(planet: ClassicalPlanet, other: ClassicalPlanet): NaturalRelation {
+  if (NATURAL_FRIENDS[planet].includes(other)) return "Friend";
+  if (NATURAL_ENEMIES[planet].includes(other)) return "Enemy";
+  return "Neutral";
+}
+
+/**
+ * Dignity of one classical planet in a sign at a given degree within that sign [0, 30).
+ * Debilitation is checked before the Moolatrikona range only because the two can never share a sign.
+ */
+export function classicalDignity(planet: ClassicalPlanet, sign: ZodiacSign, signDegree: number): ClassicalDignity {
+  if (EXALTATION_SIGN[planet] === sign) return "Exalted";
+  if (DEBILITATION_SIGN[planet] === sign) return "Debilitated";
+  const mt = MOOLATRIKONA[planet];
+  if (mt.sign === sign && signDegree >= mt.fromDeg && signDegree < mt.toDeg) return "Moolatrikona";
+  const lord = SIGN_LORDS[sign];
+  if (lord === planet) return "Own";
+  return naturalRelation(planet, lord);
+}
diff --git a/src/engine/blocks/identity.ts b/src/engine/blocks/identity.ts
