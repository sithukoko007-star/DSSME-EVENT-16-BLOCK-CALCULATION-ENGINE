+/**
+ * Phase 3 — COMBUST block tests (hand-built chart, no ephemeris).
+ * Frozen: S-02 (DSSME thresholds govern), S-02b (circular separation), S-02c (exact 50 %, boundary -> Severe).
+ */
+
+import assert from "node:assert/strict";
+import {
+  COMBUST_THRESHOLDS,
+  buildCombustBlock,
+  circularSeparation,
+  classifyCombustion,
+  createBlockContext,
+} from "../../src/engine/blocks/index.ts";
+import type { CombustBlock, CombustEntry } from "../../src/types/dssme-canonical-types.ts";
+import { HAND_JD_UT, makeHandChart } from "./fixtures/handChart.ts";
+
+type Combustible = "Moon" | "Mars" | "Mercury" | "Jupiter" | "Venus" | "Saturn";
+const PLANETS: readonly Combustible[] = ["Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"];
+const SPEC_DIRECT: Record<Combustible, number> = { Moon: 12, Mars: 17, Mercury: 14, Jupiter: 11, Venus: 10, Saturn: 15 };
+const SPEC_RETRO: Record<Exclude<Combustible, "Moon">, number> = { Mars: 17, Mercury: 13, Jupiter: 11, Venus: 8, Saturn: 15 };
+
+function entryAt(planet: Combustible, sunLon: number, planetLon: number, retro: boolean): CombustEntry {
+  const chart = makeHandChart();
+  chart.planets.Sun.siderealLongitude = sunLon;
+  chart.planets[planet].siderealLongitude = planetLon;
+  chart.planets[planet].isRetrograde = retro;
+  const r = buildCombustBlock(createBlockContext(chart));
+  assert.equal(r.status, "OK", JSON.stringify(r.issues));
+  assert.ok(r.value);
+  return r.value[planet];
+}
+
+export function runCombustBlockTests(): void {
+  console.log("Running Phase 3 COMBUST Block Tests...");
+
+  // 1. Frozen threshold table equals the DSSME spec (S-02 = A).
+  for (const p of PLANETS) {
+    assert.equal(COMBUST_THRESHOLDS[p].direct, SPEC_DIRECT[p], `${p} direct`);
+  }
+  assert.equal(COMBUST_THRESHOLDS.Moon.retro, null);
+  for (const p of ["Mars", "Mercury", "Jupiter", "Venus", "Saturn"] as const) {
+    assert.equal(COMBUST_THRESHOLDS[p].retro, SPEC_RETRO[p], `${p} retro`);
+  }
+
+  // 2. Boundaries for every planet, direct and retrograde: threshold, half (Severe), just beyond each.
+  const sun = 100;
+  for (const p of PLANETS) {
+    const modes: [boolean, number][] = [[false, SPEC_DIRECT[p]]];
+    if (p !== "Moon") modes.push([true, SPEC_RETRO[p]]);
+    for (const [retro, thr] of modes) {
+      const label = `${p} ${retro ? "retro" : "direct"} thr=${thr}`;
+      const at = (sep: number): CombustEntry => entryAt(p, sun, sun + sep, retro);
+      assert.deepEqual(at(0), { combust: true, sep_deg: 0, severity: "Severe" }, `${label} sep 0`);
+      assert.equal(at(thr / 2).severity, "Severe", `${label} half is Severe (<=)`);
+      assert.equal(at(thr / 2 + 1e-9).severity, "Mild", `${label} just above half is Mild`);
+      assert.equal(at(thr).severity, "Mild", `${label} threshold is Mild`);
+      assert.equal(at(thr).combust, true);
+      assert.deepEqual(at(thr + 1e-9).combust, false, `${label} just beyond threshold`);
+      assert.equal(at(thr + 1e-9).severity, null);
+    }
+  }
+
+  // 3. S-02c example: Jupiter 11° -> half is 5.5 (not the spec example's 6).
+  assert.equal(entryAt("Jupiter", sun, sun + 5.5, false).severity, "Severe");
+  assert.equal(entryAt("Jupiter", sun, sun + 6, false).severity, "Mild");
+  assert.equal(entryAt("Jupiter", sun, sun + 11, false).severity, "Mild");
+
+  // 4. Retrograde thresholds differ where DSSME says so: Mercury 14 -> 13, Venus 10 -> 8.
+  assert.equal(entryAt("Mercury", sun, sun + 13.5, false).combust, true);
+  assert.equal(entryAt("Mercury", sun, sun + 13.5, true).combust, false);
+  assert.equal(entryAt("Venus", sun, sun + 9, false).combust, true);
+  assert.equal(entryAt("Venus", sun, sun + 9, true).combust, false);
+  assert.equal(entryAt("Mars", sun, sun + 16, true).combust, true, "Mars keeps 17 when retrograde");
+
+  // 5. Circular separation (S-02b): the 0°/360° wrap is handled; linear difference would miss these.
+  assert.equal(circularSeparation(358, 6), 8);
+  assert.equal(circularSeparation(6, 358), 8);
+  assert.equal(circularSeparation(0, 180), 180);
+  assert.equal(circularSeparation(10, 10), 0);
+  assert.deepEqual(entryAt("Moon", 358, 6, false), { combust: true, sep_deg: 8, severity: "Mild" });
+  assert.deepEqual(entryAt("Saturn", 2, 350, false), { combust: true, sep_deg: 12, severity: "Mild" });
+  assert.deepEqual(entryAt("Moon", 359, 5, false), { combust: true, sep_deg: 6, severity: "Severe" }, "wrap + half boundary");
+
+  // 6. classifyCombustion is the single verdict function.
+  assert.deepEqual(classifyCombustion(5.5, 11), { combust: true, severity: "Severe" });
+  assert.deepEqual(classifyCombustion(5.5000001, 11), { combust: true, severity: "Mild" });
+  assert.deepEqual(classifyCombustion(11.0000001, 11), { combust: false, severity: null });
+
+  // 7. Hand chart: integer separations, Sun entry fixed, canonical key order, sep_deg also for non-combust planets.
+  const result = buildCombustBlock(createBlockContext(makeHandChart()));
+  assert.equal(result.blockId, "COMBUST");
+  assert.equal(result.status, "OK");
+  assert.deepEqual(result.issues, []);
+  assert.equal(result.instantJdUt, HAND_JD_UT);
+  const expected: CombustBlock = {
+    Sun: { combust: false, sep_deg: null, severity: null },
+    Moon: { combust: false, sep_deg: 64, severity: null },
+    Mars: { combust: false, sep_deg: 60, severity: null },
+    Mercury: { combust: false, sep_deg: 16, severity: null },
+    Jupiter: { combust: false, sep_deg: 36, severity: null },
+    Venus: { combust: false, sep_deg: 41, severity: null },
+    Saturn: { combust: false, sep_deg: 161, severity: null },
+  };
+  assert.deepEqual(result.value, expected);
+  assert.deepEqual(Object.keys(result.value ?? {}), ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"]);
+  assert.deepEqual(result.provenance, { chart: { ephemeris: "swisseph-wasm", isDegraded: false }, inputs: ["CanonicalChart"], auxSources: [] });
+
+  // 8. FAILED_CLOSED: retrograde Moon, invalid longitude; degraded provenance is consumed; determinism.
+  const retroMoon = makeHandChart();
+  retroMoon.planets.Moon.isRetrograde = true;
+  const f1 = buildCombustBlock(createBlockContext(retroMoon));
+  assert.equal(f1.status, "FAILED_CLOSED");
+  assert.equal(f1.value, null);
+  assert.ok(f1.issues.some((i) => i.severity === "error" && i.field === "planets.Moon.isRetrograde"));
+  for (const bad of [360, -1, Number.NaN]) {
+    const c = makeHandChart();
+    c.planets.Mars.siderealLongitude = bad;
+    const r = buildCombustBlock(createBlockContext(c));
+    assert.equal(r.status, "FAILED_CLOSED");
+    assert.ok(r.issues.some((i) => i.severity === "error" && i.field === "planets.Mars.siderealLongitude"));
+  }
+  const badSun = makeHandChart();
+  badSun.planets.Sun.siderealLongitude = Number.NaN;
+  assert.ok(buildCombustBlock(createBlockContext(badSun)).issues.some((i) => i.field === "planets.Sun.siderealLongitude"));
+  const degraded = buildCombustBlock(createBlockContext(makeHandChart("fallback")));
+  assert.equal(degraded.status, "OK");
+  assert.equal(degraded.provenance.chart.isDegraded, true);
+  const ctx = createBlockContext(makeHandChart());
+  assert.equal(JSON.stringify(buildCombustBlock(ctx)), JSON.stringify(buildCombustBlock(ctx)));
+
+  console.log("✓ Phase 3 COMBUST Block Tests Passed!");
+}
