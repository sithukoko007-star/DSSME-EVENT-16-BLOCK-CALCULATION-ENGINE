+/**
+ * Phase 3 — DIGNITY block tests (hand-built chart, no ephemeris).
+ * Frozen decisions: S-01 (natural friendship only), S-01b (Exalted > Moolatrikona > Own > natural relation;
+ * Mercury/Virgo Exalted; Rahu/Ketu "—"; Grt.* unreachable).
+ *
+ * PyJHora source-level alignment (NOT executed): natural tables and sign-level matrix, with the three
+ * documented PyJHora Compatibility Exceptions.
+ */
+
+import assert from "node:assert/strict";
+import {
+  NATURAL_ENEMIES,
+  NATURAL_FRIENDS,
+  buildDignityBlock,
+  classicalDignity,
+  createBlockContext,
+} from "../../src/engine/blocks/index.ts";
+import {
+  CLASSICAL_PLANETS_ORDER,
+  ZODIAC_SIGNS_ARIES_FIRST,
+  type ClassicalPlanet,
+  type DignityBlock,
+} from "../../src/types/dssme-canonical-types.ts";
+import { HAND_JD_UT, makeHandChart } from "./fixtures/handChart.ts";
+
+// PyJHora @ 48e57d29…, const.py (literals read from source). Planet ids: Sun 0 … Saturn 6.
+const PYJHORA_FRIENDLY: readonly (readonly number[])[] = [[1, 2, 4], [0, 3], [0, 1, 4], [0, 5], [0, 1, 2], [3, 6], [3, 5]];
+const PYJHORA_NEUTRAL: readonly (readonly number[])[] = [[3], [2, 4, 5, 6], [5, 6], [2, 4, 6], [6], [2, 4], [4]];
+const PYJHORA_ENEMY: readonly (readonly number[])[] = [[5, 6], [], [3], [1], [3, 5], [0, 1], [0, 1, 2]];
+/** house_strengths_of_planets: rows Sun..Saturn, columns Aries..Pisces. 5 own, 4 exalted, 3 friend, 2 samam, 1 enemy, 0 debilitated. */
+const PYJHORA_STRENGTH: readonly (readonly number[])[] = [
+  [4, 1, 2, 2, 5, 2, 0, 3, 3, 1, 1, 3],
+  [2, 4, 3, 5, 3, 3, 2, 0, 2, 2, 2, 2],
+  [5, 2, 1, 0, 3, 1, 2, 5, 3, 4, 2, 3],
+  [2, 3, 5, 1, 3, 5, 3, 2, 2, 2, 2, 0],
+  [3, 1, 1, 4, 3, 1, 1, 3, 5, 0, 2, 5],
+  [2, 5, 3, 1, 1, 0, 5, 2, 3, 3, 3, 4],
+  [0, 3, 3, 1, 1, 3, 4, 1, 2, 5, 5, 2],
+];
+const PYJHORA_CLASS: Readonly<Record<number, string>> = { 5: "Own", 4: "Exalted", 3: "Friend", 2: "Neutral", 1: "Enemy", 0: "Debilitated" };
+
+const EXPECTED_HAND: DignityBlock = {
+  Sun: "Own", // Leo 28°: outside Moolatrikona 0–20
+  Moon: "Debilitated", // Scorpio
+  Mars: "Enemy", // Gemini: lord Mercury is Mars's natural enemy
+  Mercury: "Exalted", // Virgo (DSSME spec); PyJHora: Own
+  Jupiter: "Exalted", // Cancer
+  Venus: "Moolatrikona", // Libra 9°: inside 0–15
+  Saturn: "Neutral", // Pisces: lord Jupiter is Saturn's natural neutral (reference JSON, compound: Enemy)
+  Rahu: "—",
+  Ketu: "—",
+};
+
+export function runDignityBlockTests(): void {
+  console.log("Running Phase 3 DIGNITY Block Tests...");
+
+  // 1. Hand chart equals the hand-written expectation; canonical key order; provenance / instant.
+  const result = buildDignityBlock(createBlockContext(makeHandChart()));
+  assert.equal(result.blockId, "DIGNITY");
+  assert.equal(result.status, "OK");
+  assert.deepEqual(result.issues, []);
+  assert.equal(result.instantJdUt, HAND_JD_UT);
+  assert.deepEqual(result.provenance, { chart: { ephemeris: "swisseph-wasm", isDegraded: false }, inputs: ["CanonicalChart"], auxSources: [] });
+  assert.deepEqual(result.value, EXPECTED_HAND);
+  assert.deepEqual(Object.keys(result.value ?? {}), ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn", "Rahu", "Ketu"]);
+
+  // 2. Precedence and half-open Moolatrikona ranges.
+  const d = classicalDignity;
+  assert.equal(d("Moon", "Taurus", 10), "Exalted", "Exalted beats Moolatrikona (Moon 3–30 Taurus)");
+  assert.equal(d("Moon", "Taurus", 1), "Exalted");
+  assert.equal(d("Mercury", "Virgo", 17), "Exalted", "Exalted beats Moolatrikona (Mercury Virgo 15–20)");
+  assert.equal(d("Mercury", "Virgo", 25), "Exalted", "Exalted beats Own — PyJHora Compatibility Exception (PyJHora: Own)");
+  assert.equal(d("Sun", "Leo", 19.99), "Moolatrikona");
+  assert.equal(d("Sun", "Leo", 20), "Own");
+  assert.equal(d("Mars", "Aries", 11.99), "Moolatrikona");
+  assert.equal(d("Mars", "Aries", 12), "Own");
+  assert.equal(d("Mars", "Scorpio", 5), "Own");
+  assert.equal(d("Jupiter", "Sagittarius", 9.99), "Moolatrikona");
+  assert.equal(d("Jupiter", "Sagittarius", 10), "Own");
+  assert.equal(d("Jupiter", "Pisces", 5), "Own");
+  assert.equal(d("Venus", "Libra", 14.99), "Moolatrikona");
+  assert.equal(d("Venus", "Libra", 15), "Own");
+  assert.equal(d("Venus", "Taurus", 5), "Own");
+  assert.equal(d("Saturn", "Aquarius", 19.99), "Moolatrikona");
+  assert.equal(d("Saturn", "Aquarius", 20), "Own");
+  assert.equal(d("Saturn", "Capricorn", 5), "Own");
+  assert.equal(d("Moon", "Cancer", 5), "Own", "spec gotcha: Moon in Cancer is Own, not Exalted");
+  assert.equal(d("Mercury", "Gemini", 5), "Own", "spec gotcha: Mercury in Gemini is Own, not Exalted");
+  assert.equal(d("Jupiter", "Cancer", 5), "Exalted", "spec gotcha: Jupiter in Cancer is Exalted");
+
+  // 3. Natural-only: Great Friend / Great Enemy are unreachable over every sign and a degree sweep.
+  const emitted = new Set<string>();
+  for (const planet of CLASSICAL_PLANETS_ORDER) {
+    for (const sign of ZODIAC_SIGNS_ARIES_FIRST) {
+      for (const deg of [0, 2.5, 3, 9.99, 10, 14.99, 15, 17, 19.99, 20, 25, 29.99]) emitted.add(classicalDignity(planet, sign, deg));
+    }
+  }
+  assert.deepEqual([...emitted].sort(), ["Debilitated", "Enemy", "Exalted", "Friend", "Moolatrikona", "Neutral", "Own"]);
+  assert.ok(!emitted.has("Grt.Friend") && !emitted.has("Grt.Enemy"));
+
+  // 4. Source-level alignment: natural tables == PyJHora _friendly/_neutral/_enemy (ids Sun 0 … Saturn 6).
+  CLASSICAL_PLANETS_ORDER.forEach((planet, id) => {
+    const toNames = (ids: readonly number[] | undefined): ClassicalPlanet[] =>
+      (ids ?? []).map((i) => {
+        const n = CLASSICAL_PLANETS_ORDER[i];
+        assert.ok(n !== undefined);
+        return n;
+      });
+    assert.deepEqual([...NATURAL_FRIENDS[planet]].sort(), toNames(PYJHORA_FRIENDLY[id]).sort(), `${planet} friends`);
+    assert.deepEqual([...NATURAL_ENEMIES[planet]].sort(), toNames(PYJHORA_ENEMY[id]).sort(), `${planet} enemies`);
+    const neutral = CLASSICAL_PLANETS_ORDER.filter((o) => o !== planet && !NATURAL_FRIENDS[planet].includes(o) && !NATURAL_ENEMIES[planet].includes(o));
+    assert.deepEqual([...neutral].sort(), toNames(PYJHORA_NEUTRAL[id]).sort(), `${planet} neutrals`);
+  });
+
+  // 5. Source-level alignment: all 84 sign-level cells vs PyJHora house_strengths_of_planets.
+  //    Degree 29.99 sits outside every Moolatrikona range, so only sign-level classes are compared.
+  const exceptions: string[] = [];
+  CLASSICAL_PLANETS_ORDER.forEach((planet, p) => {
+    ZODIAC_SIGNS_ARIES_FIRST.forEach((sign, s) => {
+      const row = PYJHORA_STRENGTH[p];
+      assert.ok(row !== undefined);
+      const code = row[s];
+      assert.ok(code !== undefined);
+      const pyjhora = PYJHORA_CLASS[code];
+      const dssme = classicalDignity(planet, sign, 29.99);
+      if (pyjhora !== dssme) exceptions.push(`${planet}/${sign}: DSSME ${dssme} vs PyJHora ${String(pyjhora)}`);
+    });
+  });
+  assert.deepEqual(exceptions, [
+    "Sun/Cancer: DSSME Friend vs PyJHora Neutral",
+    "Mercury/Virgo: DSSME Exalted vs PyJHora Own",
+    "Venus/Sagittarius: DSSME Neutral vs PyJHora Friend",
+  ], "exactly the three documented PyJHora Compatibility Exceptions");
+
+  // 6. FAILED_CLOSED on invalid placements; degraded provenance is consumed.
+  const badSign = makeHandChart();
+  Reflect.set(badSign.planets.Sun, "sign", "Nonsense");
+  const f1 = buildDignityBlock(createBlockContext(badSign));
+  assert.equal(f1.status, "FAILED_CLOSED");
+  assert.equal(f1.value, null);
+  assert.ok(f1.issues.some((i) => i.severity === "error" && i.field === "planets.Sun.sign"));
+  for (const bad of [-0.1, 30, Number.NaN]) {
+    const c = makeHandChart();
+    c.planets.Venus.signDegree = bad;
+    const r = buildDignityBlock(createBlockContext(c));
+    assert.equal(r.status, "FAILED_CLOSED");
+    assert.ok(r.issues.some((i) => i.severity === "error" && i.field === "planets.Venus.signDegree"));
+  }
+  const degraded = buildDignityBlock(createBlockContext(makeHandChart("mixed")));
+  assert.equal(degraded.status, "OK");
+  assert.deepEqual(degraded.provenance.chart, { ephemeris: "mixed", isDegraded: true });
+
+  // 7. Determinism.
+  const ctx = createBlockContext(makeHandChart());
+  assert.equal(JSON.stringify(buildDignityBlock(ctx)), JSON.stringify(buildDignityBlock(ctx)));
+
+  console.log("✓ Phase 3 DIGNITY Block Tests Passed! (PyJHora source-level alignment only; numerical parity not executed)");
+}
