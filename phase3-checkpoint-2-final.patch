diff --git a/src/engine/blocks/navamshaCore.ts b/src/engine/blocks/navamshaCore.ts
new file mode 100644
index 0000000..8c59b50
--- /dev/null
+++ b/src/engine/blocks/navamshaCore.ts
@@ -0,0 +1,55 @@
+/**
+ * D-9 (Navamsha) placement core — Level 2 building blocks for NAVAMSHA.
+ *
+ * NOT a block yet: `is_pushkara` is blocked by the open Decision Gate S-09 (the DSSME spec's Pushkara table
+ * differs from PyJHora's). Everything here is gate-clear.
+ *
+ * Source: PyJHora horoscope/chart/charts.py::navamsa_chart, default method "Traditional Parasara":
+ *   navamsa index  = floor(longitudeInSign / (30/9))            (0..8)
+ *   start (seed)   = fire 0 (Aries) · earth 9 (Capricorn) · air 6 (Libra) · water 3 (Cancer)
+ *   D-9 sign       = (seed + index) mod 12
+ *   D-9 degree     = (longitudeInSign * 9) mod 30
+ * This equals the classical "movable: same sign / fixed: 9th / dual: 5th" rule (asserted in tests).
+ * DIFFERENCE by design: the index uses floor((degree*9)/30), which is exact at rational boundaries (10° -> 3),
+ * whereas PyJHora's float floor-division by 3.3333333333333335 can fall one navamsa short exactly there.
+ *
+ * Dignity in D-9 (owner decision): natural friendship only; Exalted > Moolatrikona > Own precedence is
+ * applied first, with the Moolatrikona range tested against the D-9 in-sign degree.
+ */
+
+import type { CanonicalChart, Dignity, NineBody, ZodiacSign } from "../../types/dssme-canonical-types.ts";
+import { classicalDignity, isClassicalPlanet } from "./dignityTables.ts";
+import { mapNineBodies, signAt } from "./blockResult.ts";
+
+const D9_SEED: Readonly<Record<ZodiacSign, number>> = {
+  Aries: 0, Leo: 0, Sagittarius: 0, // fire
+  Taurus: 9, Virgo: 9, Capricorn: 9, // earth
+  Gemini: 6, Libra: 6, Aquarius: 6, // air
+  Cancer: 3, Scorpio: 3, Pisces: 3, // water
+};
+
 export interface D9Placement {
+  readonly sign: ZodiacSign;
+  readonly degree: number;
+}
+
+export function d9Placement(sign: ZodiacSign, signDegree: number): D9Placement {
+  const index = Math.min(8, Math.floor((signDegree * 9) / 30));
+  return { sign: signAt(D9_SEED[sign] + index), degree: (signDegree * 9) % 30 };
+}
+
+export interface NavamshaPlacement {
+  readonly sign: ZodiacSign;
+  readonly dignity: Dignity;
+  readonly isVargottama: boolean;
+}
+
+/** D-9 sign, D-9 dignity and Vargottama for all nine bodies, in canonical order. Nodes carry "—". */
+export function navamshaPlacements(chart: CanonicalChart): Record<NineBody, NavamshaPlacement> {
+  return mapNineBodies((body) => {
+    const p = chart.planets[body];
+    const d9 = d9Placement(p.sign, p.signDegree);
+    const dignity: Dignity = isClassicalPlanet(body) ? classicalDignity(body, d9.sign, d9.degree) : "—";
+    return { sign: d9.sign, dignity, isVargottama: d9.sign === p.sign };
+  });
+}
diff --git a/src/engine/blocks/panchangaFlags.ts b/src/engine/blocks/panchangaFlags.ts
new file mode 100644
index 0000000..adc6727
--- /dev/null
+++ b/src/engine/blocks/panchangaFlags.ts
@@ -0,0 +1,66 @@
+/**
+ * PANCHANGA state flags — Level 2 (partial PANCHANGA contribution; the full block is NOT built yet).
+ *
+ * Only the three CHART-INSTANT flags. `eclipse_proximity` and `ingress_stacking` are temporal and wait for
+ * the EventEphemeris checkpoint. The value type is a Pick of the existing PanchangaBlock interface; the
+ * result carries blockId "PANCHANGA" because it is that block's contribution, to be merged by the assembler.
+ *
+ * T-09 (CLOSED by owner): candidate A — cyclic discrete tithi index from PanchangaResult.tithi.index (1..30).
+ *   amavasya_zone = index in {29, 30, 1}        purnima_zone = index in {14, 15, 16}
+ *   Elongation is NOT recomputed.
+ *
+ * gandanta_active (spec extraction Rule 8; not one of the 20 gates): Moon OR Lagna within the LAST 3°20′ of
+ *   Cancer / Scorpio / Pisces, or the FIRST 3°20′ of Aries / Leo / Sagittarius. Boundary choice (not
+ *   specified): half-open — last zone [26°40′, 30°), first zone [0°, 3°20′).
+ */
+
+import type { PanchangaBlock, ZodiacSign } from "../../types/dssme-canonical-types.ts";
+import type { BlockContext, BlockIssue, BlockResult } from "./blockTypes.ts";
+import { errorIssue, finalizeBlock } from "./blockResult.ts";
+
+export type PanchangaStateFlags = Pick<PanchangaBlock, "gandanta_active" | "amavasya_zone" | "purnima_zone">;
+
+const GANDANTA_SPAN_DEG = 10 / 3; // 3°20′
+const WATER_ENDS: readonly ZodiacSign[] = ["Cancer", "Scorpio", "Pisces"];
+const FIRE_STARTS: readonly ZodiacSign[] = ["Aries", "Leo", "Sagittarius"];
+
+export function isAmavasyaZone(tithiIndex: number): boolean {
+  return tithiIndex === 29 || tithiIndex === 30 || tithiIndex === 1;
+}
+
+export function isPurnimaZone(tithiIndex: number): boolean {
+  return tithiIndex === 14 || tithiIndex === 15 || tithiIndex === 16;
+}
+
+export function isGandanta(sign: ZodiacSign, signDegree: number): boolean {
+  if (WATER_ENDS.includes(sign)) return signDegree >= 30 - GANDANTA_SPAN_DEG && signDegree < 30;
+  if (FIRE_STARTS.includes(sign)) return signDegree >= 0 && signDegree < GANDANTA_SPAN_DEG;
+  return false;
+}
+
+export function buildPanchangaStateFlags(ctx: BlockContext): BlockResult<PanchangaStateFlags> {
+  const issues: BlockIssue[] = [];
+  const pan = ctx.panchanga;
+  if (pan === undefined) {
+    issues.push(errorIssue("panchanga", "PanchangaResult is required for the Panchanga state flags"));
+  } else if (!Number.isInteger(pan.tithi.index) || pan.tithi.index < 1 || pan.tithi.index > 30) {
+    issues.push(errorIssue("panchanga.tithi.index", `tithi index must be an integer 1-30, found ${String(pan.tithi.index)}`));
+  }
+  const { chart } = ctx;
+  for (const [name, p] of [["Moon", chart.planets.Moon], ["Lagna", chart.lagna]] as const) {
+    if (!Number.isFinite(p.signDegree) || p.signDegree < 0 || p.signDegree >= 30) {
+      issues.push(errorIssue(`${name}.signDegree`, `degree ${String(p.signDegree)} outside [0, 30)`));
+    }
+  }
+  const value: PanchangaStateFlags | null =
+    issues.some((i) => i.severity === "error") || pan === undefined
+      ? null
+      : {
+          gandanta_active:
+            isGandanta(chart.planets.Moon.sign, chart.planets.Moon.signDegree) ||
+            isGandanta(chart.lagna.sign, chart.lagna.signDegree),
+          amavasya_zone: isAmavasyaZone(pan.tithi.index),
+          purnima_zone: isPurnimaZone(pan.tithi.index),
+        };
+  return finalizeBlock({ blockId: "PANCHANGA", ctx, inputs: ["CanonicalChart", "PanchangaResult"], value, issues });
+}
