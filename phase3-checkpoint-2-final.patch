index 0000000..af9bb36
--- /dev/null
+++ b/src/engine/blocks/identity.ts
@@ -0,0 +1,177 @@
+/**
+ * Block 1 — IDENTITY (Level 1).
+ *
+ * Decision Gate S-08 (CLOSED): canonical output follows the engine's typed contract / current repository
+ * representation, NOT the reference JSON. bodyMode is "9-body"; coordinates are numeric internally and
+ * rendered to strings only here, at the output boundary; aliases are accepted only at this input boundary.
+ *
+ * Formats (each in ONE function below, so a later decision can change it in one place):
+ *   timezone         "UTC+09:00"   frozen formatOffsetDisplay (spec: "UTC±HH:MM")
+ *   latitude/longitude "35.65N"     |value| exactly as the number prints + hemisphere letter, no rounding
+ *   ayanamsa_value   "24.2300"     chart.ayanamsa.value, positive decimal degrees, 4 dp   [residual R4]
+ *   lagna_degree     "25°09'04\""  frozen formatDms (rounds seconds); never "30°…" (guarded)
+ *   day              civil weekday of the LOCAL date (not the sunrise-based Vara)
+ *
+ * Session parameters (body_mode, objective, risk, geometry) pass through, never calculated. Absent => the
+ * spec literal "NOT_FOUND" (extraction Rule 12/13) with a warning and status DEFAULTED. Present but invalid
+ * => error => FAILED_CLOSED.
+ *
+ * No new Jyotish calculation: nothing here reads PyJHora.
+ */
+
+import type { IdentityBlock } from "../../types/dssme-canonical-types.ts";
+import { formatDms } from "../astronomy/ayanamsa.ts";
+import { getLagnaType } from "../astronomy/ascendant.ts";
+import { weekdayOf } from "../panchanga/vara.ts";
+import { formatOffsetDisplay } from "../../utils/timezoneHelper.ts";
+import type { BlockContext, BlockIssue, BlockResult } from "./blockTypes.ts";
+import { errorIssue, finalizeBlock, warningIssue } from "./blockResult.ts";
+
+export const NOT_FOUND = "NOT_FOUND";
+
+const WEEKDAYS: readonly string[] = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
+const RISKS: readonly string[] = ["LOW", "MEDIUM", "HIGH", "OBSERVE"];
+const GEOMETRIES: readonly string[] = ["ordered_2_digit", "ordered_3_digit"];
+
+/** Hemisphere-suffixed coordinate: |value| exactly as JS prints it, no rounding. */
+export function formatCoordinate(value: number, positive: string, negative: string): string {
+  return `${String(Math.abs(value))}${value < 0 ? negative : positive}`;
+}
+
+/** "9:05" / "09:05" / "09:05:07" -> "HH:MM:SS"; null if not a time. */
+export function normalizeTime(raw: string): string | null {
+  const m = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(raw.trim());
+  if (!m) return null;
+  const hour = Number(m[1]);
+  const minute = Number(m[2]);
+  const second = m[3] === undefined ? 0 : Number(m[3]);
+  if (hour > 23 || minute > 59 || second > 59) return null;
+  const pad = (n: number): string => String(n).padStart(2, "0");
+  return `${pad(hour)}:${pad(minute)}:${pad(second)}`;
+}
+
+/** Canonical "9-body" | "7-body"; alias "Full" is accepted at this input boundary only. */
+export function normalizeBodyMode(raw: string): "9-body" | "7-body" | null {
+  const v = raw.trim();
+  if (v === "9-body" || v === "Full") return "9-body";
+  if (v === "7-body") return "7-body";
+  return null;
+}
+
+function civilWeekday(date: string): string | null {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
+  if (!m) return null;
+  const weekday = weekdayOf({ year: Number(m[1]), month: Number(m[2]), day: Number(m[3]) });
+  return WEEKDAYS[weekday] ?? null;
+}
+
+function lagnaDegreeString(signDegree: number, issues: BlockIssue[]): string {
+  const formatted = formatDms(signDegree);
+  if (formatted.startsWith("30")) {
+    // Rounding carried into the next sign: keep the in-sign degree strictly below 30.
+    issues.push(warningIssue("lagna_degree", "seconds rounding reached 30°; clamped to 29°59'59\""));
+    return "29°59'59\"";
+  }
+  return formatted;
+}
+
+export function buildIdentityBlock(ctx: BlockContext): BlockResult<IdentityBlock> {
+  const { chart } = ctx;
+  const issues: BlockIssue[] = [];
+  let defaulted = false;
+  const missing = (field: string, why: string): string => {
+    defaulted = true;
+    issues.push(warningIssue(field, `${why}; reporting "${NOT_FOUND}"`));
+    return NOT_FOUND;
+  };
+
+  const date = chart.input.date;
+  const day = civilWeekday(date);
+  if (day === null) issues.push(errorIssue("date", `cannot derive weekday from "${date}"`));
+
+  const time = normalizeTime(chart.input.time);
+  if (time === null) issues.push(errorIssue("time", `invalid time "${chart.input.time}"`));
+
+  const offset = chart.time.timezoneOffsetHours;
+  if (!Number.isFinite(offset)) issues.push(errorIssue("timezone", "timezone offset is not finite"));
+
+  const lat = chart.location.latitude;
+  const lon = chart.location.longitude;
+  if (!Number.isFinite(lat) || Math.abs(lat) > 90) issues.push(errorIssue("latitude", `invalid latitude ${String(lat)}`));
+  if (!Number.isFinite(lon) || Math.abs(lon) > 180) issues.push(errorIssue("longitude", `invalid longitude ${String(lon)}`));
+
+  const city = chart.location.city ?? missing("location_city", "no city supplied");
+  const country = chart.location.country ?? missing("location_country", "no country supplied");
+
+  const rawBody = chart.input.bodyMode;
+  let bodyMode: string;
+  if (rawBody === undefined) {
+    bodyMode = missing("body_mode", "session parameter not supplied");
+  } else {
+    const normalized = normalizeBodyMode(rawBody);
+    if (normalized === null) {
+      issues.push(errorIssue("body_mode", `unrecognized bodyMode "${rawBody}" (expected 9-body, 7-body, or alias Full)`));
+      bodyMode = NOT_FOUND;
+    } else {
+      bodyMode = normalized;
+    }
+  }
+
+  const objective = chart.input.objective ?? missing("objective", "session parameter not supplied");
+
+  const rawRisk = chart.input.risk;
+  let risk: string;
+  if (rawRisk === undefined) {
+    risk = missing("risk", "session parameter not supplied");
+  } else if (!RISKS.includes(rawRisk)) {
+    issues.push(errorIssue("risk", `invalid risk "${rawRisk}" (expected ${RISKS.join("|")})`));
+    risk = NOT_FOUND;
+  } else {
+    risk = rawRisk;
+  }
+
+  const rawGeometry = chart.input.geometry;
+  let geometry: string;
+  if (rawGeometry === undefined) {
+    geometry = missing("geometry", "session parameter not supplied");
+  } else if (!GEOMETRIES.includes(rawGeometry)) {
+    issues.push(errorIssue("geometry", `invalid geometry "${rawGeometry}" (expected ${GEOMETRIES.join("|")})`));
+    geometry = NOT_FOUND;
+  } else {
+    geometry = rawGeometry;
+  }
+
+  const engineVersion = ctx.engineVersion ?? missing("engine_version", "no engine version supplied to the block context");
+
+  if (chart.ayanamsa.name !== "Lahiri") issues.push(errorIssue("ayanamsa_name", `unsupported ayanamsa "${String(chart.ayanamsa.name)}"`));
+  if (!Number.isFinite(chart.ayanamsa.value)) issues.push(errorIssue("ayanamsa_value", "ayanamsa value is not finite"));
+  if (!Number.isFinite(chart.lagna.signDegree) || chart.lagna.signDegree < 0 || chart.lagna.signDegree >= 30) {
+    issues.push(errorIssue("lagna_degree", `lagna degree ${String(chart.lagna.signDegree)} outside [0,30)`));
+  }
+
+  const hasError = issues.some((i) => i.severity === "error");
+  const value: IdentityBlock | null =
+    hasError || day === null || time === null
+      ? null
+      : {
+          date,
+          day,
+          time,
+          timezone: formatOffsetDisplay(offset),
+          location_city: city,
+          location_country: country,
+          latitude: formatCoordinate(lat, "N", "S"),
+          longitude: formatCoordinate(lon, "E", "W"),
+          ayanamsa_name: chart.ayanamsa.name,
+          ayanamsa_value: chart.ayanamsa.value.toFixed(4),
+          lagna_sign: chart.lagna.sign,
+          lagna_degree: lagnaDegreeString(chart.lagna.signDegree, issues),
+          lagna_type: getLagnaType(chart.lagna.sign),
+          body_mode: bodyMode,
+          objective,
+          risk,
+          geometry,
+          engine_version: engineVersion,
+        };
+  return finalizeBlock({ blockId: "IDENTITY", ctx, inputs: ["CanonicalChart"], value, issues, defaulted });
+}
