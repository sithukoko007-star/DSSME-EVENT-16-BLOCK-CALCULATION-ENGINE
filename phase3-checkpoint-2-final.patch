+/**
+ * Block 13 (DIGNITY) — Level 2. Natural-friendship-only dignity (gates S-01 / S-01b closed).
+ * Rahu and Ketu carry no dignity of their own: always "—" (no exaltation / MT / own / friendship logic).
+ * See dignityTables.ts for the frozen precedence and sources.
+ */
+
+import type { ClassicalPlanet, DignityBlock } from "../../types/dssme-canonical-types.ts";
+import { ZODIAC_SIGNS_ARIES_FIRST } from "../../types/dssme-canonical-types.ts";
+import type { BlockContext, BlockIssue, BlockResult } from "./blockTypes.ts";
+import { errorIssue, finalizeBlock, mapNineBodies } from "./blockResult.ts";
+import { classicalDignity, isClassicalPlanet } from "./dignityTables.ts";
+
+const CLASSICAL: readonly ClassicalPlanet[] = ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"];
+
+function validate(ctx: BlockContext): BlockIssue[] {
+  const issues: BlockIssue[] = [];
+  for (const planet of CLASSICAL) {
+    const p = ctx.chart.planets[planet];
+    if (!p) {
+      issues.push(errorIssue(`planets.${planet}`, `${planet} is missing`));
+      continue;
+    }
+    if (!ZODIAC_SIGNS_ARIES_FIRST.includes(p.sign)) {
+      issues.push(errorIssue(`planets.${planet}.sign`, `invalid sign "${String(p.sign)}"`));
+    }
+    if (!Number.isFinite(p.signDegree) || p.signDegree < 0 || p.signDegree >= 30) {
+      issues.push(errorIssue(`planets.${planet}.signDegree`, `degree ${String(p.signDegree)} outside [0, 30)`));
+    }
+  }
+  return issues;
+}
+
+export function buildDignityBlock(ctx: BlockContext): BlockResult<DignityBlock> {
+  const issues = validate(ctx);
+  const hasError = issues.some((i) => i.severity === "error");
+  const value: DignityBlock | null = hasError
+    ? null
+    : mapNineBodies((body) => {
+        if (!isClassicalPlanet(body)) return "—";
+        const p = ctx.chart.planets[body];
+        return classicalDignity(body, p.sign, p.signDegree);
+      });
+  return finalizeBlock({ blockId: "DIGNITY", ctx, inputs: ["CanonicalChart"], value, issues });
+}
