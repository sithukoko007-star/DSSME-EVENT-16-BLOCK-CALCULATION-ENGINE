+++ b/tests/blocks/level2Integration.test.ts
@@ -0,0 +1,84 @@
+/**
+ * Phase 3, Level 2 — integration: live CanonicalChart -> PanchangaResult -> Level 2 blocks.
+ *
+ * Real Swiss engine. Assertions are SIGN-LEVEL or carry wide margins, so they hold regardless of the
+ * open degree-level discrepancy between the engine and the Chofu reference JSON (gate T-10).
+ */
+
+import assert from "node:assert/strict";
+import { generateCanonicalChart } from "../../src/engine/canonical/canonicalChart.ts";
+import { computePanchanga, fromCanonicalChart } from "../../src/engine/panchanga/index.ts";
+import {
+  buildCombustBlock,
+  buildDignityBlock,
+  buildPanchangaStateFlags,
+  createBlockContext,
+  navamshaPlacements,
+} from "../../src/engine/blocks/index.ts";
+
+export async function runLevel2IntegrationTests(): Promise<void> {
+  console.log("Running Phase 3 Level 2 Integration Tests (CanonicalChart -> PanchangaResult -> blocks)...");
+
+  const chart = await generateCanonicalChart({
+    date: "2026-09-16",
+    time: "18:50:00",
+    latitude: 35.65,
+    longitude: 139.54,
+    timezone: "Asia/Tokyo",
+    timezoneOffset: 9,
+    ayanamsa: "Lahiri",
+  });
+  const panchanga = computePanchanga(fromCanonicalChart(chart), {}, { varaMode: "civil", includeBoundaries: false });
+  const ctx = createBlockContext(chart, panchanga);
+
+  // DIGNITY (natural friendship only): sign-level facts, Venus 9.4° is far inside Libra 0–15, Sun 29.3° far outside Leo 0–20.
+  const dignity = buildDignityBlock(ctx);
+  assert.equal(dignity.status, "OK", JSON.stringify(dignity.issues));
+  assert.deepEqual(dignity.value, {
+    Sun: "Own",
+    Moon: "Debilitated",
+    Mars: "Enemy",
+    Mercury: "Exalted",
+    Jupiter: "Exalted",
+    Venus: "Moolatrikona",
+    Saturn: "Neutral",
+    Rahu: "—",
+    Ketu: "—",
+  });
+
+  // COMBUST: nobody combust at this instant (Mercury is ~15.8° from the Sun, threshold 14).
+  const combust = buildCombustBlock(ctx);
+  assert.equal(combust.status, "OK", JSON.stringify(combust.issues));
+  for (const planet of ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn"] as const) {
+    assert.equal(combust.value?.[planet].combust, false, planet);
+  }
+  const mercurySep = combust.value?.Mercury.sep_deg;
+  assert.ok(mercurySep !== null && mercurySep !== undefined && mercurySep > 14 && mercurySep < 18, `Mercury sep ${String(mercurySep)}`);
+  assert.equal(combust.value?.Sun.sep_deg, null);
+
+  // PANCHANGA state flags: tithi 6 (Shukla), Moon Scorpio 2°, Lagna Pisces 25° -> all false.
+  const flags = buildPanchangaStateFlags(ctx);
+  assert.equal(flags.status, "OK", JSON.stringify(flags.issues));
+  assert.equal(panchanga.tithi.index, 6);
+  assert.deepEqual(flags.value, { gandanta_active: false, amavasya_zone: false, purnima_zone: false });
+  assert.deepEqual(flags.provenance.inputs, ["CanonicalChart", "PanchangaResult"]);
+
+  // D-9 core: Mars at ~28.7° Gemini is in the 9th navamsa of a dual sign -> Gemini (Vargottama), margin 2° from the boundary.
+  const d9 = navamshaPlacements(chart);
+  assert.equal(chart.planets.Mars.sign, "Gemini");
+  assert.equal(d9.Mars.sign, "Gemini");
+  assert.equal(d9.Mars.isVargottama, true);
+  assert.equal(d9.Rahu.dignity, "—");
+
+  // Determinism, and degraded chart provenance flows through.
+  assert.equal(JSON.stringify(buildDignityBlock(ctx)), JSON.stringify(dignity));
+  assert.equal(JSON.stringify(buildCombustBlock(ctx)), JSON.stringify(combust));
+  const degradedChart = { ...chart, provenance: { ...chart.provenance, ephemeris: "fallback" as const, isDegraded: true } };
+  const degradedCtx = createBlockContext(degradedChart, panchanga);
+  for (const r of [buildDignityBlock(degradedCtx), buildCombustBlock(degradedCtx), buildPanchangaStateFlags(degradedCtx)]) {
+    assert.equal(r.status, "OK");
+    assert.deepEqual(r.provenance.chart, { ephemeris: "fallback", isDegraded: true });
+  }
+
+  console.log("✓ Phase 3 Level 2 Integration Tests Passed!");
+}
