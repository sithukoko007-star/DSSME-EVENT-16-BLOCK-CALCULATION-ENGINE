+/**
+ * Block 13 (COMBUST) — Level 2.
+ *
+ * Frozen decisions (owner, 2026-10-03 — reports/PHASE_3_DECISION_LOG.md):
+ *   S-02  DSSME Master Contract governs. PyJHora is a non-authoritative reference: its own two consumers of
+ *         the combustion lists index them differently (charts.py [p-2] vs rashmi.py [p_id-1]).
+ *   S-02b separation is CIRCULAR: min(|a-b|, 360-|a-b|).
+ *   S-02c severity splits at exactly 50 % of the threshold, boundary belongs to SEVERE:
+ *         sep <= half -> Severe ; half < sep <= threshold -> Mild ; sep > threshold -> not combust.
+ *
+ * Thresholds (degrees)       direct  retrograde
+ *   Moon                      12      n/a (Moon is never retrograde)
+ *   Mars                      17      17
+ *   Mercury                   14      13
+ *   Jupiter                   11      11
+ *   Venus                     10       8
+ *   Saturn                    15      15
+ * Retrograde status is the frozen Swiss-speed flag (CanonicalBodyPosition.isRetrograde).
+ * Sun has no combustion: combust=false, sep_deg=null, severity=null (spec template).
+ * sep_deg is the raw circular separation (no rounding) for the six non-Sun planets, combust or not.
+ */
+
+import type { ClassicalPlanet, CombustBlock, CombustEntry } from "../../types/dssme-canonical-types.ts";
+import type { BlockContext, BlockIssue, BlockResult } from "./blockTypes.ts";
+import { errorIssue, finalizeBlock } from "./blockResult.ts";
+
+type Combustible = Exclude<ClassicalPlanet, "Sun">;
+
+interface Threshold {
+  readonly direct: number;
+  readonly retro: number | null;
+}
+
+export const COMBUST_THRESHOLDS: Readonly<Record<Combustible, Threshold>> = {
+  Moon: { direct: 12, retro: null },
+  Mars: { direct: 17, retro: 17 },
+  Mercury: { direct: 14, retro: 13 },
+  Jupiter: { direct: 11, retro: 11 },
+  Venus: { direct: 10, retro: 8 },
+  Saturn: { direct: 15, retro: 15 },
+};
+
+export function circularSeparation(a: number, b: number): number {
+  const raw = Math.abs(a - b);
+  return Math.min(raw, 360 - raw);
+}
+
 export function classifyCombustion(separation: number, threshold: number): Pick<CombustEntry, "combust" | "severity"> {
+  if (separation > threshold) return { combust: false, severity: null };
+  return { combust: true, severity: separation <= threshold / 2 ? "Severe" : "Mild" };
+}
+
+function validLongitude(value: number): boolean {
+  return Number.isFinite(value) && value >= 0 && value < 360;
+}
+
+function entryFor(ctx: BlockContext, planet: Combustible, issues: BlockIssue[]): CombustEntry {
+  const body = ctx.chart.planets[planet];
+  const sun = ctx.chart.planets.Sun;
+  const empty: CombustEntry = { combust: false, sep_deg: null, severity: null };
+  if (!validLongitude(body.siderealLongitude)) {
+    issues.push(errorIssue(`planets.${planet}.siderealLongitude`, `invalid longitude ${String(body.siderealLongitude)}`));
+    return empty;
+  }
+  if (typeof body.isRetrograde !== "boolean") {
+    issues.push(errorIssue(`planets.${planet}.isRetrograde`, "isRetrograde must be boolean"));
+    return empty;
+  }
+  const t = COMBUST_THRESHOLDS[planet];
+  let threshold = t.direct;
+  if (body.isRetrograde) {
+    if (t.retro === null) {
+      issues.push(errorIssue(`planets.${planet}.isRetrograde`, `${planet} can never be retrograde`));
+      return empty;
+    }
+    threshold = t.retro;
+  }
+  const sep = circularSeparation(body.siderealLongitude, sun.siderealLongitude);
+  const verdict = classifyCombustion(sep, threshold);
+  return { combust: verdict.combust, sep_deg: sep, severity: verdict.severity };
+}
+
+export function buildCombustBlock(ctx: BlockContext): BlockResult<CombustBlock> {
+  const issues: BlockIssue[] = [];
+  if (!validLongitude(ctx.chart.planets.Sun.siderealLongitude)) {
+    issues.push(errorIssue("planets.Sun.siderealLongitude", `invalid longitude ${String(ctx.chart.planets.Sun.siderealLongitude)}`));
+  }
+  const e = (p: Combustible): CombustEntry => entryFor(ctx, p, issues);
+  const value: CombustBlock = {
+    Sun: { combust: false, sep_deg: null, severity: null },
+    Moon: e("Moon"),
+    Mars: e("Mars"),
+    Mercury: e("Mercury"),
+    Jupiter: e("Jupiter"),
+    Venus: e("Venus"),
+    Saturn: e("Saturn"),
+  };
+  return finalizeBlock({ blockId: "COMBUST", ctx, inputs: ["CanonicalChart"], value, issues });
+}
