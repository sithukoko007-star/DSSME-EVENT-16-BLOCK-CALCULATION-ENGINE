+/**
+ * Phase 3 — IDENTITY block tests (hand-built chart, no ephemeris).
+ * Decision Gate S-08 (CLOSED): canonical engine representation; "Full" is an input alias for "9-body".
+ */
+
+import assert from "node:assert/strict";
+import {
+  NOT_FOUND,
+  buildIdentityBlock,
+  createBlockContext,
+  formatCoordinate,
+  normalizeBodyMode,
+  normalizeTime,
+} from "../../src/engine/blocks/index.ts";
+import type { CanonicalChart } from "../../src/types/dssme-canonical-types.ts";
+import { HAND_JD_UT, makeHandChart } from "./fixtures/handChart.ts";
+
+function fullyDeclared(): CanonicalChart {
+  const chart = makeHandChart();
+  chart.input = {
+    ...chart.input,
+    bodyMode: "Full",
+    objective: "short-cycle speculative extraction",
+    risk: "MEDIUM",
+    geometry: "ordered_3_digit",
+  };
+  chart.location = { ...chart.location, city: "Chofu", country: "Japan" };
+  return chart;
+}
+
 export function runIdentityBlockTests(): void {
+  console.log("Running Phase 3 IDENTITY Block Tests...");
+
+  // 1. Fully declared session + engine version => OK, spec-shaped strings, alias normalized.
+  const ok = buildIdentityBlock(createBlockContext(fullyDeclared(), undefined, { engineVersion: "TEST-ENGINE-VERSION" }));
+  assert.equal(ok.blockId, "IDENTITY");
+  assert.equal(ok.status, "OK", JSON.stringify(ok.issues));
+  assert.deepEqual(ok.issues, []);
+  assert.equal(ok.instantJdUt, HAND_JD_UT);
+  assert.deepEqual(ok.provenance, { chart: { ephemeris: "swisseph-wasm", isDegraded: false }, inputs: ["CanonicalChart"], auxSources: [] });
+  assert.deepEqual(ok.value, {
+    date: "2026-09-16",
+    day: "Wednesday",
+    time: "18:50:00",
+    timezone: "UTC+09:00",
+    location_city: "Chofu",
+    location_country: "Japan",
+    latitude: "35.65N",
+    longitude: "139.54E",
+    ayanamsa_name: "Lahiri",
+    ayanamsa_value: "24.2300",
+    lagna_sign: "Pisces",
+    lagna_degree: "25°00'00\"",
+    lagna_type: "Dual",
+    body_mode: "9-body",
+    objective: "short-cycle speculative extraction",
+    risk: "MEDIUM",
+    geometry: "ordered_3_digit",
+    engine_version: "TEST-ENGINE-VERSION",
+  });
+  assert.deepEqual(Object.keys(ok.value ?? {}), [
+    "date", "day", "time", "timezone", "location_city", "location_country", "latitude", "longitude",
+    "ayanamsa_name", "ayanamsa_value", "lagna_sign", "lagna_degree", "lagna_type",
+    "body_mode", "objective", "risk", "geometry", "engine_version",
+  ]);
+
+  // 2. Nothing declared => DEFAULTED with the spec literal NOT_FOUND (never a guess) + warnings, no errors.
+  const bare = buildIdentityBlock(createBlockContext(makeHandChart()));
+  assert.equal(bare.status, "DEFAULTED");
+  assert.ok(bare.issues.every((i) => i.severity === "warning"));
+  const fields = bare.issues.map((i) => i.field).sort();
+  assert.deepEqual(fields, ["body_mode", "engine_version", "geometry", "location_city", "location_country", "objective", "risk"]);
+  assert.equal(bare.value?.body_mode, NOT_FOUND);
+  assert.equal(bare.value?.engine_version, NOT_FOUND);
+  assert.equal(bare.value?.risk, NOT_FOUND);
+  assert.equal(bare.value?.date, "2026-09-16", "calculated fields are still produced");
+
+  // 3. Invalid session parameters => FAILED_CLOSED (error), value null.
+  const failFor = (mutate: (c: CanonicalChart) => void, field: string): void => {
+    const c = fullyDeclared();
+    mutate(c);
+    const r = buildIdentityBlock(createBlockContext(c, undefined, { engineVersion: "v" }));
+    assert.equal(r.status, "FAILED_CLOSED", field);
+    assert.equal(r.value, null);
+    assert.ok(r.issues.some((i) => i.severity === "error" && i.field === field), `${field}: ${JSON.stringify(r.issues)}`);
+  };
+  failFor((c) => { c.input = { ...c.input, bodyMode: "Bogus" }; }, "body_mode");
+  failFor((c) => { c.input = { ...c.input, risk: "EXTREME" }; }, "risk");
+  failFor((c) => { c.input = { ...c.input, geometry: "ordered_4_digit" }; }, "geometry");
+  failFor((c) => { c.input = { ...c.input, date: "2026-13-45x" }; }, "date");
+  failFor((c) => { c.input = { ...c.input, time: "25:00:00" }; }, "time");
+  failFor((c) => { c.lagna.signDegree = 31; }, "lagna_degree");
+  failFor((c) => { c.location = { ...c.location, latitude: 91 }; }, "latitude");
+  failFor((c) => { c.location = { ...c.location, longitude: -181 }; }, "longitude");
+
+  // 4. "7-body" passes through; "9-body" is canonical; "Full" is only an input alias.
+  const seven = fullyDeclared();
+  seven.input = { ...seven.input, bodyMode: "7-body" };
+  assert.equal(buildIdentityBlock(createBlockContext(seven, undefined, { engineVersion: "v" })).value?.body_mode, "7-body");
+  assert.equal(normalizeBodyMode("9-body"), "9-body");
+  assert.equal(normalizeBodyMode("Full"), "9-body");
+  assert.equal(normalizeBodyMode("full"), null, "alias match is exact");
+  assert.equal(normalizeBodyMode(""), null);
+
+  // 5. Coordinates: numeric internally, hemisphere letter, no rounding.
+  assert.equal(formatCoordinate(35.65, "N", "S"), "35.65N");
+  assert.equal(formatCoordinate(-33.8688, "N", "S"), "33.8688S");
+  assert.equal(formatCoordinate(139.54, "E", "W"), "139.54E");
+  assert.equal(formatCoordinate(-74.006, "E", "W"), "74.006W");
+  assert.equal(formatCoordinate(0, "N", "S"), "0N");
+
+  // 6. Times, timezone offsets, weekday (local civil date).
+  assert.equal(normalizeTime("9:05"), "09:05:00");
+  assert.equal(normalizeTime("09:05:07"), "09:05:07");
+  assert.equal(normalizeTime("24:00:00"), null);
+  assert.equal(normalizeTime("12:60:00"), null);
+  assert.equal(normalizeTime("noon"), null);
+  const india = fullyDeclared();
+  india.time = { ...india.time, timezoneOffsetHours: 5.5 };
+  assert.equal(buildIdentityBlock(createBlockContext(india, undefined, { engineVersion: "v" })).value?.timezone, "UTC+05:30");
+  const ny = fullyDeclared();
+  ny.time = { ...ny.time, timezoneOffsetHours: -4 };
+  assert.equal(buildIdentityBlock(createBlockContext(ny, undefined, { engineVersion: "v" })).value?.timezone, "UTC-04:00");
+  const leap = fullyDeclared();
+  leap.input = { ...leap.input, date: "2024-02-29" };
+  assert.equal(buildIdentityBlock(createBlockContext(leap, undefined, { engineVersion: "v" })).value?.day, "Thursday");
+
+  // 7. Lagna degree never prints "30°": rounding that would reach 30° is clamped, with a warning.
+  const edge = fullyDeclared();
+  edge.lagna.signDegree = 29.9999;
+  const e = buildIdentityBlock(createBlockContext(edge, undefined, { engineVersion: "v" }));
+  assert.equal(e.value?.lagna_degree, "29°59'59\"");
+  assert.ok(e.issues.some((i) => i.severity === "warning" && i.field === "lagna_degree"));
+  assert.equal(e.status, "OK", "a clamp warning is not a default and not an error");
+
+  // 8. Lagna type follows the sign (Movable / Fixed / Dual).
+  for (const [sign, type] of [["Aries", "Movable"], ["Taurus", "Fixed"], ["Gemini", "Dual"], ["Scorpio", "Fixed"]] as const) {
+    const c = fullyDeclared();
+    c.lagna.sign = sign;
+    assert.equal(buildIdentityBlock(createBlockContext(c, undefined, { engineVersion: "v" })).value?.lagna_type, type);
+  }
+
+  // 9. Determinism and degraded provenance.
+  const ctx = createBlockContext(fullyDeclared(), undefined, { engineVersion: "v" });
+  assert.equal(JSON.stringify(buildIdentityBlock(ctx)), JSON.stringify(buildIdentityBlock(ctx)));
+  const degraded = fullyDeclared();
+  degraded.provenance = { ...degraded.provenance, ephemeris: "fallback", isDegraded: true };
+  const d = buildIdentityBlock(createBlockContext(degraded, undefined, { engineVersion: "v" }));
+  assert.equal(d.status, "OK");
+  assert.deepEqual(d.provenance.chart, { ephemeris: "fallback", isDegraded: true });
+  assert.ok(!/generatedAt|calculatedAt|timestamp/i.test(JSON.stringify(ok)));
+
+  console.log("✓ Phase 3 IDENTITY Block Tests Passed!");
+}
