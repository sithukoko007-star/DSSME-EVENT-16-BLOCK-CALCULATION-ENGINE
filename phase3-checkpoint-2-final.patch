+/**
+ * Phase 3 — PANCHANGA state-flag tests (hand-built chart + hand-built PanchangaResult, no ephemeris).
+ * T-09 (CLOSED): candidate A — cyclic discrete tithi index: amavasya {29,30,1}, purnima {14,15,16}.
+ */
+
+import assert from "node:assert/strict";
+import {
+  buildPanchangaStateFlags,
+  createBlockContext,
+  isAmavasyaZone,
+  isGandanta,
+  isPurnimaZone,
+} from "../../src/engine/blocks/index.ts";
+import { HAND_JD_UT, makeHandChart } from "./fixtures/handChart.ts";
+import { makePanchanga } from "./fixtures/handPanchanga.ts";
+
+export function runPanchangaFlagsTests(): void {
+  console.log("Running Phase 3 PANCHANGA State-Flag Tests...");
+
+  // 1. T-09: every tithi index 1..30.
+  const amavasya = new Set([29, 30, 1]);
+  const purnima = new Set([14, 15, 16]);
+  for (let t = 1; t <= 30; t++) {
+    assert.equal(isAmavasyaZone(t), amavasya.has(t), `amavasya ${t}`);
+    assert.equal(isPurnimaZone(t), purnima.has(t), `purnima ${t}`);
+    const r = buildPanchangaStateFlags(createBlockContext(makeHandChart(), makePanchanga(t)));
+    assert.equal(r.status, "OK");
+    assert.equal(r.value?.amavasya_zone, amavasya.has(t));
+    assert.equal(r.value?.purnima_zone, purnima.has(t));
+  }
+
+  // 2. Gandanta boundaries (last 3°20′ of water signs, first 3°20′ of fire signs; half-open).
+  assert.equal(isGandanta("Cancer", 26.7), true);
+  assert.equal(isGandanta("Cancer", 26.6), false);
+  assert.equal(isGandanta("Scorpio", 29.99), true);
+  assert.equal(isGandanta("Pisces", 27), true);
+  assert.equal(isGandanta("Cancer", 0.1), false, "start of a water sign is not gandanta");
+  assert.equal(isGandanta("Aries", 3.3), true);
+  assert.equal(isGandanta("Aries", 3.4), false);
+  assert.equal(isGandanta("Leo", 0), true);
+  assert.equal(isGandanta("Sagittarius", 3), true);
+  assert.equal(isGandanta("Leo", 29), false, "end of a fire sign is not gandanta");
+  for (const sign of ["Taurus", "Gemini", "Virgo", "Libra", "Capricorn", "Aquarius"] as const) {
+    assert.equal(isGandanta(sign, 0), false, `${sign} start`);
+    assert.equal(isGandanta(sign, 29.99), false, `${sign} end`);
+  }
+
+  // 3. Moon OR Lagna.
+  const base = buildPanchangaStateFlags(createBlockContext(makeHandChart(), makePanchanga(6)));
+  assert.deepEqual(base.value, { gandanta_active: false, amavasya_zone: false, purnima_zone: false });
+  assert.deepEqual(Object.keys(base.value ?? {}), ["gandanta_active", "amavasya_zone", "purnima_zone"]);
+  const lagna = makeHandChart();
+  lagna.lagna.signDegree = 27; // Pisces 27°
+  assert.equal(buildPanchangaStateFlags(createBlockContext(lagna, makePanchanga(6))).value?.gandanta_active, true);
+  const moon = makeHandChart();
+  moon.planets.Moon.sign = "Cancer";
+  moon.planets.Moon.signDegree = 27;
+  assert.equal(buildPanchangaStateFlags(createBlockContext(moon, makePanchanga(6))).value?.gandanta_active, true);
+
+  // 4. Contract: provenance, instant, determinism, degraded chart.
+  assert.equal(base.blockId, "PANCHANGA");
+  assert.equal(base.instantJdUt, HAND_JD_UT);
+  assert.deepEqual(base.provenance, { chart: { ephemeris: "swisseph-wasm", isDegraded: false }, inputs: ["CanonicalChart", "PanchangaResult"], auxSources: [] });
+  const ctx = createBlockContext(makeHandChart(), makePanchanga(15));
+  assert.equal(JSON.stringify(buildPanchangaStateFlags(ctx)), JSON.stringify(buildPanchangaStateFlags(ctx)));
+  const degraded = buildPanchangaStateFlags(createBlockContext(makeHandChart("fallback"), makePanchanga(15)));
+  assert.equal(degraded.status, "OK");
+  assert.equal(degraded.provenance.chart.isDegraded, true);
+
+  // 5. FAILED_CLOSED: missing PanchangaResult, invalid tithi index, invalid degrees.
+  const missing = buildPanchangaStateFlags(createBlockContext(makeHandChart()));
+  assert.equal(missing.status, "FAILED_CLOSED");
+  assert.equal(missing.value, null);
+  assert.ok(missing.issues.some((i) => i.severity === "error" && i.field === "panchanga"));
+  for (const bad of [0, 31, 2.5, Number.NaN]) {
+    const r = buildPanchangaStateFlags(createBlockContext(makeHandChart(), makePanchanga(bad)));
+    assert.equal(r.status, "FAILED_CLOSED", `tithi ${bad}`);
+    assert.ok(r.issues.some((i) => i.severity === "error" && i.field === "panchanga.tithi.index"));
+  }
+  const badDeg = makeHandChart();
+  badDeg.planets.Moon.signDegree = 30;
+  assert.ok(buildPanchangaStateFlags(createBlockContext(badDeg, makePanchanga(6))).issues.some((i) => i.field === "Moon.signDegree"));
+
+  console.log("✓ Phase 3 PANCHANGA State-Flag Tests Passed!");
+}
