@@ -0,0 +1,86 @@
+/**
+ * Phase 3 — D-9 (Navamsha) core tests. NAVAMSHA block itself is NOT built: `is_pushkara` waits for gate S-09.
+ * PyJHora source-level alignment: charts.navamsa_chart, method "Traditional Parasara" (element seeds).
+ */
+
+import assert from "node:assert/strict";
+import { d9Placement, navamshaPlacements } from "../../src/engine/blocks/index.ts";
+import { ZODIAC_SIGNS_ARIES_FIRST, type CanonicalChart, type NineBody, type ZodiacSign } from "../../src/types/dssme-canonical-types.ts";
+import { makeHandChart } from "./fixtures/handChart.ts";
+
+/** Independent classical rule: movable -> same sign, fixed -> 9th from it, dual -> 5th from it. */
+function classicalD9Sign(signIndex: number, navamsa: number): ZodiacSign {
+  const mod = signIndex % 3; // Aries 0 movable, Taurus 1 fixed, Gemini 2 dual (repeats every 3 signs)
+  const start = mod === 0 ? signIndex : mod === 1 ? signIndex + 8 : signIndex + 4;
+  const sign = ZODIAC_SIGNS_ARIES_FIRST[(start + navamsa) % 12];
+  assert.ok(sign !== undefined);
+  return sign;
+}
+
+const dms = (d: number, m: number, s: number): number => d + m / 60 + s / 3600;
+
+export function runNavamshaCoreTests(): void {
+  console.log("Running Phase 3 D-9 (Navamsha) Core Tests...");
+
+  // 1. All 12 signs x 9 navamsas: element-seed rule (PyJHora) == classical movable/fixed/dual rule.
+  ZODIAC_SIGNS_ARIES_FIRST.forEach((sign, signIndex) => {
+    for (let n = 0; n < 9; n++) {
+      const midpoint = (n + 0.5) * (30 / 9);
+      assert.equal(d9Placement(sign, midpoint).sign, classicalD9Sign(signIndex, n), `${sign} navamsa ${n + 1}`);
+    }
+  });
+
+  // 2. D-9 degree = (degree * 9) mod 30, and the exact rational boundaries land in the NEXT navamsa.
+  assert.equal(d9Placement("Aries", 1).degree, 9);
+  assert.equal(d9Placement("Aries", 10).sign, "Cancer", "10° = start of the 4th navamsa");
+  assert.equal(d9Placement("Aries", 10).degree, 0);
+  assert.equal(d9Placement("Aries", 0).sign, "Aries");
+  assert.equal(d9Placement("Aries", 29.999999).sign, "Sagittarius", "9th navamsa; index clamped to 8");
+  assert.equal(d9Placement("Leo", 20).sign, d9Placement("Leo", 20.0000001).sign);
+
+  // 3. Reference JSON INTERNAL consistency (its own positions -> its own Navamsha column).
+  //    Structural check only: NOT an engine golden (degree-level discrepancy T-10 is open).
+  const reference: readonly [NineBody, ZodiacSign, number, ZodiacSign, boolean][] = [
+    ["Sun", "Leo", dms(28, 57, 17), "Sagittarius", false],
+    ["Moon", "Scorpio", dms(2, 16, 23), "Cancer", false],
+    ["Mars", "Gemini", dms(28, 22, 43), "Gemini", true],
+    ["Mercury", "Virgo", dms(14, 47, 9), "Taurus", false],
+    ["Jupiter", "Cancer", dms(22, 16, 7), "Capricorn", false],
+    ["Venus", "Libra", dms(9, 7, 25), "Sagittarius", false],
+    ["Saturn", "Pisces", dms(17, 57, 15), "Sagittarius", false],
+    ["Rahu", "Aquarius", dms(4, 15, 18), "Scorpio", false],
+    ["Ketu", "Leo", dms(4, 15, 18), "Taurus", false],
+  ];
+  const chart: CanonicalChart = makeHandChart();
+  for (const [body, sign, degree] of reference) {
+    chart.planets[body].sign = sign;
+    chart.planets[body].signDegree = degree;
+  }
+  const placements = navamshaPlacements(chart);
+  assert.deepEqual(Object.keys(placements), ["Sun", "Moon", "Mars", "Mercury", "Jupiter", "Venus", "Saturn", "Rahu", "Ketu"]);
+  for (const [body, , , d9Sign, vargottama] of reference) {
+    assert.equal(placements[body].sign, d9Sign, `${body} D-9 sign`);
+    assert.equal(placements[body].isVargottama, vargottama, `${body} vargottama`);
+  }
+  // Navamsha dignity, natural friendship only (matches the reference's printed column for all seven planets).
+  assert.deepEqual(
+    [placements.Sun.dignity, placements.Moon.dignity, placements.Mars.dignity, placements.Mercury.dignity, placements.Jupiter.dignity, placements.Venus.dignity, placements.Saturn.dignity],
+    ["Friend", "Own", "Enemy", "Friend", "Debilitated", "Neutral", "Neutral"],
+  );
+  assert.equal(placements.Rahu.dignity, "—");
+  assert.equal(placements.Ketu.dignity, "—");
+
+  // 4. Navamsha dignity never introduces Grt.* (natural-only), and applies Exalted/Moolatrikona/Own first.
+  const probe = makeHandChart();
+  probe.planets.Venus.sign = "Libra";
+  probe.planets.Venus.signDegree = 0.5; // D-9: Libra seed 6 + navamsa 0 = Libra, D-9 degree 4.5 -> Moolatrikona (Libra 0–15)
+  assert.equal(navamshaPlacements(probe).Venus.sign, "Libra");
+  assert.equal(navamshaPlacements(probe).Venus.isVargottama, true);
+  assert.equal(navamshaPlacements(probe).Venus.dignity, "Moolatrikona");
+  for (const p of Object.values(placements)) assert.ok(p.dignity !== "Grt.Friend" && p.dignity !== "Grt.Enemy");
+
+  // 5. Determinism.
+  assert.equal(JSON.stringify(navamshaPlacements(chart)), JSON.stringify(navamshaPlacements(chart)));
+
+  console.log("✓ Phase 3 D-9 (Navamsha) Core Tests Passed! (source-level alignment only; is_pushkara pending S-09)");
+}
